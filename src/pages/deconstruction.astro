const loadDeconSlot = (slotIndex) => {
  const slots = readSlots('deconstruction');
  const s = slots[slotIndex];
  if (!s) return;

  const item = itemById.get(s.pageState.itemId);
  if (!item) {
    alert('저장된 아이템을 더 이상 찾을 수 없습니다.');
    return;
  }

  const doLoad = () => {
    const itemChanged = selectedItem?.id !== item.id;
    clearDeconCalculationState(item);
    selectedItem = item;
    commitSuggestedItem(item, { syncFilters: false });

    // commitSuggestedItem skips resetAllowedSources because we set
    // selectedItem above — reset manually when switching items.
    if (itemChanged) resetAllowedSources();

    const ps = s.pageState;
    deconDeltas = { ...(ps.deconDeltas ?? {}) };
    deconSlotState = setSuccessfulScrollCount(deconSlotState, ps.successfulScrollCount ?? 0);
    deconStatKeys = ps.deconStatKeys ? [...ps.deconStatKeys] : deconStatKeys;
    deconSlotState = setRemainingSlotCount(deconSlotState, ps.remainingSlots ?? deconSlotState.maxSlots);
    deconAppliedLevelCount = ps.appliedLevelCount ?? 0;

    deconHasActionableResults = false;
    renderDeconSlotState();
    renderDeconItemLevel();
    rebuildStatEditor();
    updateTargetCard();
    renderDeconSlotBar();
    checkDeconStarState();
    updateAnalyzeButton();
  };

  if (hasDeconDraftState()) {
    showDeconConfirmDialog(doLoad);
  } else {
    doLoad();
  }
};

// ---- Star button click ----
if (deconStar instanceof HTMLElement) {
  deconStar.addEventListener('click', () => {
    if (deconStar.classList.contains('item-card-star--saved')) {
      confirmUnsaveDeconSlot();
    } else {
      showDeconSavePicker();
    }
  });
}

// ---- Analyze click handler ----
const getCheckedTargetKeys = () => {
  if (!(deconTargetChips instanceof HTMLElement)) return [];
  const checkboxes = deconTargetChips.querySelectorAll('input:checked');
  return [...checkboxes].map(cb => cb.dataset.deconTargetKey).filter(Boolean);
};

const runAnalysis = () => {
  if (!selectedItem) return;

  const equipmentKind = selectedItem.equipmentKind;
  const checkedKeys = getCheckedTargetKeys();

  // Build targetDeltas for every checked key (including negative and zero)
  const targetDeltas = Object.fromEntries(
    checkedKeys.map((key) => [key, deconDeltas[key] ?? 0]),
  );

  const levelUpDef = itemLevelUpByItemId.get(selectedItem.id);
  const maxLevelUps = Number.isInteger(levelUpDef?.maxLevelUps) ? levelUpDef.maxLevelUps : 0;
  const appliedCount = Math.max(0, Math.min(maxLevelUps, deconAppliedLevelCount));
  const result = enumerateStrategies({
    targetDeltas,
    targetKeys: checkedKeys,
    successfulScrollCount: deconSlotState.successfulScrollCount,
    equipmentKind,
    allowedSources: getAllowedSources(),
    requiredLevel: selectedItem.requiredLevel ?? 0,
    requiredJobs: selectedItem.requiredJobs ?? [],
    cleanStats: selectedItem.stats ?? {},
    scrollsByEquipmentKind,
    levelUpDefinition: levelUpDef ?? null,
    scrollRateFilter: deconScrollRateFilter.size > 0 ? deconScrollRateFilter : null,
    stimulantStatBounds: Object.keys(deconStimulantBoundsMap).length > 0 ? deconStimulantBoundsMap : null,
    chaosStatBounds: Object.keys(deconChaosBoundsMap).length > 0 ? deconChaosBoundsMap : null,
    gemFilter: deconGemFilter,
    levelUpExactLevelCount: appliedCount,
    levelUpTotalStatRanges: appliedCount > 0 && Object.keys(deconLevelUpTotalRanges).length > 0
      ? deconLevelUpTotalRanges
      : null,
  });

  displayResults(result, targetDeltas);
};

// ---- Display results ----
const displayResults = (result, targetDeltas) => {
  if (
    !(deconResultPlaceholder instanceof HTMLElement) ||
    !(deconResultContent instanceof HTMLElement)
  ) {
    return;
  }

  deconResultPlaceholder.hidden = true;
  deconResultContent.hidden = false;
  deconHasActionableResults = false;
  deconResultContent.querySelector('.decon-summary')?.remove();

  const filterChipsContainer = document.querySelector('[data-decon-filter-chips]');
  const listContainer = document.querySelector('[data-decon-strategy-list]');
  if (
    !(filterChipsContainer instanceof HTMLElement) ||
    !(listContainer instanceof HTMLElement)
  ) {
    return;
  }
  filterChipsContainer.replaceChildren();
  listContainer.replaceChildren();

  resultFilterController.reset();

  // Summary line
  const summary = document.createElement('p');
  summary.className = 'decon-summary';
  deconResultContent.prepend(summary);
  if (result.tooManyResults) {
    summary.textContent = '일치하는 전략이 10,000개를 초과합니다. 위 패널에서 목표 조건을 더 구체적으로 선택해주세요.';
    return;
  }
  if (result.strategies.length === 0) {
    summary.textContent = '일치하는 전략을 찾을 수 없습니다.';
    return;
  }

  deconHasActionableResults = true;
  summary.textContent = `총 ${result.total}개의 전략을 찾았습니다.`;

  // Filter chips — exclude gems when item is not maker-gem-eligible
  const stimulantFilterLabel = deconGemEligible ? '촉진제/추옵' : '추가 옵션';
  const FILTER_DEFS = [
    { source: null, label: '전체' },
    { source: 'scrolls', label: '주문서' },
    { source: 'stimulant', label: stimulantFilterLabel },
    ...(deconGemEligible ? [{ source: 'gems', label: '보석 (메이커)' }] : []),
    { source: 'itemLevelUp', label: '레벨업' },
  ];

  for (const def of FILTER_DEFS) {
    const chip = document.createElement('button');
    chip.type = 'button';
    chip.className = 'decon-filter-chip';
    chip.dataset.deconFilter = def.source ?? 'all';
    chip.setAttribute('aria-pressed', 'false');
    chip.textContent = def.source === null
      ? `${def.label} (${result.strategies.length})`
      : def.label;
    filterChipsContainer.append(chip);
  }

  // Strategy list
  const filterEmpty = document.createElement('p');
  filterEmpty.className = 'decon-filter-empty';
  filterEmpty.dataset.deconFilterEmpty = '';
  filterEmpty.textContent = '선택한 조합에 해당하는 전략이 없습니다.';
  filterEmpty.hidden = true;
  listContainer.append(filterEmpty);

  result.strategies.forEach((strategy, strategyIndex) => {
    const card = document.createElement('div');
    card.className = 'decon-strategy-card';
    card.dataset.strategyIndex = String(strategyIndex);

    // Source type for filtering
    card.dataset.sourceTypes = strategy.sourceTypes.join(',');

    // 1. Header — analysis number
    const headerRow = document.createElement('div');
    headerRow.className = 'decon-strategy-approach';
    headerRow.textContent = `분석 ${strategyIndex + 1}번`;
    card.append(headerRow);

    // 2. Total stats — summary subtitle
    const statRow = document.createElement('div');
    statRow.className = 'decon-strategy-stats';
    const sortStatEntries = (entries) => [...entries].sort(([a], [b]) => {
      const ai = STAT_ORDER.indexOf(a);
      const bi = STAT_ORDER.indexOf(b);
      return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
    });
    const statParts = sortStatEntries(Object.entries(strategy.totalStats))
      .filter(([, v]) => v !== 0)
      .map(([k, v]) => `${statLabelByKey[k] ?? k} ${v > 0 ? '+' : ''}${v}`);
    statRow.textContent = statParts.join(', ');
    card.append(statRow);

    // 2. Scrolls — grouped by ID, rendered as a compact table
    const scrollGroups = new Map();
    for (const s of strategy.scrolls) {
      const isChaos = s.behavior_type === 'chaos';
      // Chaos: key includes stat deltas so each unique outcome gets its own row.
      // Fixed: key is just the id (all applications have identical stats).
      const groupKey = isChaos
        ? `${s.id}|${JSON.stringify(s.stats)}`
        : String(s.id);
      if (!scrollGroups.has(groupKey)) {
        scrollGroups.set(groupKey, { scroll: s, count: 0 });
      }
      scrollGroups.get(groupKey).count++;
    }

    if (scrollGroups.size > 0) {
      const table = document.createElement('div');
      table.className = 'decon-scroll-table';

      for (const [, group] of scrollGroups) {
        const row = document.createElement('div');
        row.className = 'decon-scroll-row';

        // Count
        const countCell = document.createElement('span');
        countCell.className = 'decon-scroll-count';
        countCell.textContent = `×${group.count}`;
        row.append(countCell);

        // Name + effect stacked
        const nameCell = document.createElement('span');
        nameCell.className = 'decon-scroll-name';

        const topLine = document.createElement('span');
        topLine.className = 'decon-scroll-name-top';

        const icon = document.createElement('img');
        icon.className = 'decon-scroll-icon';
        const iconId = group.scroll.behavior_type === 'chaos' ? 2049100 : group.scroll.id;
        icon.src = buildItemIconUrl(iconId);
        icon.alt = '';
        icon.loading = 'lazy';
        topLine.append(icon);

        const label = document.createElement('span');
        label.textContent = simplifyScrollDisplayName(group.scroll.nameKo);
        topLine.append(label);

        nameCell.append(topLine);

        // Effect sub-line
        const effects = sortStatEntries(Object.entries(group.scroll.stats))
          .filter(([, v]) => v !== 0)
          .map(([k, v]) => `${statLabelByKey[k] ?? k} ${v > 0 ? '+' : ''}${v}`);
        const subLine = document.createElement('span');
        subLine.className = 'decon-scroll-name-sub';
        subLine.textContent = effects.length > 0
          ? `└ ${effects.join(', ')}`
          : '└ 변동없음';
        nameCell.append(subLine);

        row.append(nameCell);
        table.append(row);
      }

      card.append(table);
    }

    // 3. Source details (stimulant, gems, itemLevelUp)
    const formatSourceStats = (stats) => sortStatEntries(Object.entries(stats))
      .filter(([, value]) => value !== 0)
      .map(([key, value]) => `${statLabelByKey[key] ?? key}: ${value > 0 ? '+' : ''}${value}`)
      .join(', ');

    const appendSourceRow = (cardEl, label, stats) => {
      const formatted = formatSourceStats(stats);
      if (!formatted) return;
      const row = document.createElement('div');
      row.className = 'decon-strategy-source';
      row.textContent = `⤷ ${label}: ${formatted}`;
      cardEl.append(row);
    };

    if (strategy.stimulant) appendSourceRow(card, deconGemEligible ? '촉진제/추옵' : '추가 옵션', strategy.stimulant.stats);
    if (strategy.gems.length > 0) {
      for (const gem of strategy.gems) {
        appendSourceRow(card, `${gem.nameKo ?? gem.gemKey} ${GEM_GRADES[gem.gradeIndex] ?? ''}`, gem.stats);
      }
    }
    if (strategy.itemLevelUp) {
      const il = strategy.itemLevelUp;
      if (il.appliedLevelCount > 0 && il.levelCount > il.appliedLevelCount) {
        // Both applied and remaining
        appendSourceRow(card, `아이템 레벨업 ${il.levelCount}회 (적용 ${il.appliedLevelCount}회)`, il.stats);
      } else {
        appendSourceRow(card, `아이템 레벨업 ${il.levelCount}회`, il.stats);
      }
    }

    listContainer.append(card);
  });

  resultFilterController.initialize(result.strategies);
};

// ---- Filter ----

// ---- Event listeners ----
levelInputs?.forEach((input) => {
  if (!(input instanceof HTMLInputElement)) return;
  input.addEventListener('input', () => {
    syncItemSearchUrl();
    renderManualItemResults();
  });
  input.addEventListener('blur', () => {
    input.value = String(Math.max(0, Math.min(200, parseInt(input.value, 10) || 0)));
    syncItemSearchUrl();
    renderManualItemResults();
  });
});

stepButtons?.forEach((button) => {
  button.addEventListener('click', () => {
    if (!(button instanceof HTMLButtonElement)) return;
    const targetInput =
      button.dataset.levelBound === 'max' ? levelMaxInput : levelMinInput;
    if (!(targetInput instanceof HTMLInputElement)) return;
    const delta = Number.parseInt(button.dataset.levelStep ?? '0', 10);
    const current = parseInt(targetInput.value, 10) || 0;
    targetInput.value = String(Math.max(0, Math.min(200, current + delta)));
    syncItemSearchUrl();
    renderManualItemResults();
  });
});

itemNameInput?.addEventListener('input', () => {
  syncItemSearchUrl();
  renderItemSuggestions();
});

manualSearchToggle?.addEventListener('click', () => {
  if (!(manualSearchToggle instanceof HTMLButtonElement)) return;
  setManualSearchOpen(manualSearchToggle.getAttribute('aria-expanded') !== 'true');
});

itemNameInput?.addEventListener('keydown', (event) => {
  if (event instanceof KeyboardEvent && event.key === 'Escape') {
    hideItemSuggestions();
  }
});

equipmentTrigger?.addEventListener('keydown', (event) => {
  if (event instanceof KeyboardEvent && event.key === 'Escape') {
    if (equipmentMenu instanceof HTMLElement && equipmentTrigger instanceof HTMLButtonElement) {
      equipmentMenu.hidden = true;
      equipmentTrigger.setAttribute('aria-expanded', 'false');
      toggleEquipmentDropdownOpen(false);
    }
  }
});

if (equipmentInput instanceof HTMLInputElement) {
  equipmentTrigger?.addEventListener('click', () => {
    if (!(equipmentMenu instanceof HTMLElement) || !(equipmentTrigger instanceof HTMLButtonElement)) return;
    const activeMode = form?.querySelector('.segment.active');
    if (!activeMode) return;
    const willOpen = equipmentMenu.hidden;
    equipmentMenu.hidden = !willOpen;
    equipmentTrigger.setAttribute('aria-expanded', String(willOpen));
    toggleEquipmentDropdownOpen(willOpen);
  });

  equipmentModeButtons?.forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const mode = button.dataset.equipmentMode;
      const matchingGroup = form?.querySelector(`[data-equipment-options="${mode}"]`);
      equipmentOptionGroups?.forEach((group) => {
        if (group instanceof HTMLElement) {
          group.hidden = group !== matchingGroup;
        }
      });
      equipmentModeButtons.forEach((modeButton) => {
        modeButton.classList.toggle('active', modeButton === button);
      });
      const selectedOption =
        matchingGroup?.querySelector('.equipment-option.active') ??
        matchingGroup?.querySelector('[data-equipment-option]');
      if (selectedOption instanceof HTMLButtonElement) {
        setEquipmentOption(selectedOption);
        renderManualItemResults();
      }
    });
  });
}

equipmentOptionButtons?.forEach((button) => {
  button.addEventListener('click', () => {
    setEquipmentOption(button);
  });
});

document.addEventListener('click', (event) => {
  if (
    equipmentDropdown instanceof HTMLElement &&
    equipmentMenu instanceof HTMLElement &&
    equipmentTrigger instanceof HTMLButtonElement &&
    event.target instanceof Node &&
    !equipmentDropdown.contains(event.target)
  ) {
    equipmentMenu.hidden = true;
    equipmentTrigger.setAttribute('aria-expanded', 'false');
  }
  if (
    itemNameSearch instanceof HTMLElement &&
    itemSuggestions instanceof HTMLElement &&
    itemNameInput instanceof HTMLInputElement &&
    event.target instanceof Node &&
    !itemNameSearch.contains(event.target)
  ) {
    hideItemSuggestions();
  }
});

jobInputs?.forEach((input) => {
  input.addEventListener('change', () => {
    syncJobButtons();
    renderManualItemResults();
  });
});

jobSelectAllButton?.addEventListener('click', () => {
  jobInputs?.forEach((input) => {
    if (input instanceof HTMLInputElement) {
      input.checked = true;
    }
  });
  syncJobButtons();
  renderManualItemResults();
});

jobClearAllButton?.addEventListener('click', () => {
  jobInputs?.forEach((input) => {
    if (input instanceof HTMLInputElement) {
      input.checked = false;
    }
  });
  syncJobButtons();
  renderManualItemResults();
});

// ---- Slot steppers ----
deconSuccessMin?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setSuccessfulScrollCount(deconSlotState, 0);
  renderDeconSlotState();
}));
deconSuccessDec?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setSuccessfulScrollCount(deconSlotState, deconSlotState.successfulScrollCount - 1);
  renderDeconSlotState();
}));
deconSuccessInc?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setSuccessfulScrollCount(deconSlotState, deconSlotState.successfulScrollCount + 1);
  renderDeconSlotState();
}));
deconSuccessMax?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setSuccessfulScrollCount(deconSlotState, deconSlotState.maxSlots);
  renderDeconSlotState();
}));
deconSlotMin?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setRemainingSlotCount(deconSlotState, 0);
  renderDeconSlotState();
}));
deconSlotDec?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setRemainingSlotCount(deconSlotState, deconSlotState.remainingSlots - 1);
  renderDeconSlotState();
}));
deconSlotInc?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setRemainingSlotCount(deconSlotState, deconSlotState.remainingSlots + 1);
  renderDeconSlotState();
}));
deconSlotMax?.addEventListener('click', () => guardDeconMutation(() => {
  deconSlotState = setRemainingSlotCount(deconSlotState, deconSlotState.maxSlots);
  renderDeconSlotState();
}));

// ---- Level steppers ----
deconLevelMinBtn?.addEventListener('click', () => guardDeconMutation(() => {
  deconAppliedLevelCount = 0;
  deconLevelUpTotalRanges = {};
  renderDeconItemLevel();
  updateLevelUpSourceEligibility();
}));
deconLevelDecBtn?.addEventListener('click', () => guardDeconMutation(() => {
  if (deconAppliedLevelCount > 0) {
    deconAppliedLevelCount--;
    deconLevelUpTotalRanges = {};
    renderDeconItemLevel();
    updateLevelUpSourceEligibility();
  }
}));
deconLevelIncBtn?.addEventListener('click', () => guardDeconMutation(() => {
  const def = selectedItem ? itemLevelUpByItemId.get(selectedItem.id) : null;
  const maxLevelUps = Number.isInteger(def?.maxLevelUps) ? def.maxLevelUps : 0;
  if (deconAppliedLevelCount < maxLevelUps) {
    deconAppliedLevelCount++;
    deconLevelUpTotalRanges = {};
    renderDeconItemLevel();
    updateLevelUpSourceEligibility();
  }
}));
deconLevelMaxBtn?.addEventListener('click', () => guardDeconMutation(() => {
  const def = selectedItem ? itemLevelUpByItemId.get(selectedItem.id) : null;
  const maxLevelUps = Number.isInteger(def?.maxLevelUps) ? def.maxLevelUps : 0;
  deconAppliedLevelCount = maxLevelUps;
  deconLevelUpTotalRanges = {};
  renderDeconItemLevel();
  updateLevelUpSourceEligibility();
}));

deconScrollRateInputs.forEach((chip) => {
  chip.addEventListener('change', () => {
    guardCheckboxMutation(chip, guardDeconMutation, () => {
      const rate = chip.dataset.deconScrollRate;
      if (chip.checked) {
        deconScrollRateFilter.add(rate);
      } else {
        deconScrollRateFilter.delete(rate);
      }
      // Toggle chaos stat bounds editor
      if (rate === 'chaos' && deconChaosBounds instanceof HTMLElement) {
        if (chip.checked) {
          deconChaosBounds.hidden = false;
          deconChaosBounds.classList.add('decon-source-sub--open');
          buildChaosBoundsEditor();
        } else {
          deconChaosBounds.classList.remove('decon-source-sub--open');
          deconChaosBounds.hidden = true;
          deconChaosBoundsMap = {};
        }
      }
      checkDeconStarState();
    });
  });
});

// ---- Add-stat accordion toggle ----
deconAddStatToggle?.addEventListener('click', () => {
  if (!(deconAddStatList instanceof HTMLElement) || !(deconAddStatToggle instanceof HTMLElement)) return;
  const isOpen = !deconAddStatList.hidden;
  deconAddStatList.hidden = isOpen;
  deconAddStatToggle.classList.toggle('decon-add-stat-toggle--open', !isOpen);
});

// ---- Analyze button ----
deconAnalyzeBtn?.addEventListener('click', runAnalysis);
deconScrollSource?.addEventListener('change', () => {
  guardCheckboxMutation(deconScrollSource, guardDeconMutation, () => {
    toggleSourceSub(deconScrollSource, deconScrollRateSub, () => {
      deconScrollRateFilter = new Set(['100', '60', '10']);
      deconScrollRateInputs.forEach(inp => {
        if (inp instanceof HTMLInputElement) {
          inp.checked = deconScrollRateFilter.has(inp.dataset.deconScrollRate);
        }
      });
    });
    updateAnalyzeButton();
  });
});

deconStimulantSource?.addEventListener('change', () => {
  guardCheckboxMutation(deconStimulantSource, guardDeconMutation, () => {
    toggleSourceSub(deconStimulantSource, deconStimulantBounds, () => {
      buildStimulantBoundsEditor();
    });
    updateAnalyzeButton();
  });
});

deconGemsSource?.addEventListener('change', () => {
  guardCheckboxMutation(deconGemsSource, guardDeconMutation, () => {
    toggleSourceSub(deconGemsSource, deconGemSub, () => {
      deconGemFilter = null;
      buildGemPreFilter();
    });
    if (!deconGemsSource.checked) {
      deconGemFilter = null;
    }
    updateAnalyzeButton();
  });
});

deconItemLevelUpSource?.addEventListener('change', () => {
  guardCheckboxMutation(deconItemLevelUpSource, guardDeconMutation, () => {
    toggleSourceSub(deconItemLevelUpSource, deconLevelSlotRanges, () => {
      buildLevelUpSlotEditors();
    });
    updateAnalyzeButton();
  });
});

// ---- Reset button ----
const showDeconConfirmDialog = (onConfirm) => {
  const overlay = document.createElement('div');
  overlay.className = 'decon-confirm-overlay';

  const dialog = document.createElement('div');
  dialog.className = 'decon-confirm-dialog';

  const msg = document.createElement('p');
  msg.textContent = '모든 계산 설정과 분석 결과를 초기화합니다. 계속하시겠습니까?';

  const buttonRow = document.createElement('div');
  buttonRow.className = 'decon-confirm-buttons';

  const confirmBtn = document.createElement('button');
  confirmBtn.textContent = '초기화';
  confirmBtn.addEventListener('click', () => {
    overlay.remove();
    onConfirm();
  });

  const cancelBtn = document.createElement('button');
  cancelBtn.textContent = '취소';
  cancelBtn.addEventListener('click', () => overlay.remove());

  buttonRow.append(confirmBtn, cancelBtn);
  dialog.append(msg, buttonRow);
  overlay.append(dialog);
  document.body.append(overlay);
};

const showDeconItemChangeDialog = (onConfirm) => {
  const overlay = document.createElement('div');
  overlay.className = 'decon-confirm-overlay';

  const dialog = document.createElement('div');
  dialog.className = 'decon-confirm-dialog';

  const msg = document.createElement('p');
  msg.textContent = '아이템을 변경하면 현재 스탯 편집과 분석 결과가 초기화됩니다. 계속하시겠습니까?';

  const buttonRow = document.createElement('div');
  buttonRow.className = 'decon-confirm-buttons';

  const confirmBtn = document.createElement('button');
  confirmBtn.textContent = '변경';
  confirmBtn.addEventListener('click', () => {
    overlay.remove();
    onConfirm();
  });

  const cancelBtn = document.createElement('button');
  cancelBtn.textContent = '취소';
  cancelBtn.addEventListener('click', () => overlay.remove());

  buttonRow.append(confirmBtn, cancelBtn);
  dialog.append(msg, buttonRow);
  overlay.append(dialog);
  document.body.append(overlay);
};

document.querySelector('[data-enhancement-reset]')?.addEventListener('click', () => {
  showDeconConfirmDialog(() => {
    deconDeltas = {};
    resetAllowedSources();
    deconSlotState = createDeconstructionSlotState(selectedItem?.stats?.upgradeSlots ?? 0);
    renderDeconSlotState();
    if (deconStatEditor instanceof HTMLElement) {
      deconStatEditor.replaceChildren();
    }
    // Collapse all source accordions in Section 3
    const allSubs = [deconScrollRateSub, deconStimulantBounds, deconGemSub, deconLevelSlotRanges, deconChaosBounds];
    for (const sub of allSubs) {
      if (sub instanceof HTMLElement) {
        sub.classList.remove('decon-source-sub--open');
        sub.hidden = true;
      }
    }
    if (selectedItem) {
      activateDeconEditPanel(selectedItem);
    }
    if (deconResultPlaceholder instanceof HTMLElement) deconResultPlaceholder.hidden = false;
    if (deconResultContent instanceof HTMLElement) deconResultContent.hidden = true;
    deconHasActionableResults = false;
  });
});

// ---- Init ----
setManualSearchOpen(false);
syncJobButtons();
syncItemSearchUrl();
renderDeconSlotBar();

// Load item index
fetch('/data/items-gms83-ko.json')
  .then((response) => {
    if (!response.ok) throw new Error(`Unable to load item index: ${response.status}`);
    return response.json();
  })
  .then((items) => {
    itemIndex = Array.isArray(items) ? items : [];
    itemIndex = itemIndex.filter((item) => Object.keys(item.stats ?? {}).length > 0);
    itemById = new Map(itemIndex.map((item) => [item.id, item]));
    const initialSelectedItemId =
      selectedItemIdInput instanceof HTMLInputElement ? Number.parseInt(selectedItemIdInput.value, 10) : NaN;
    if (itemById.has(initialSelectedItemId)) {
      selectSuggestedItem(itemById.get(initialSelectedItemId));
    }
    renderItemSuggestions();
    renderDeconSlotBar();
  })
  .catch((error) => {
    console.error(error);
  });

// Load scroll and item-level-up data
let itemLevelUpByItemId = new Map();

Promise.all([
  fetch('/data/scrolls-gms83-ko.json').then((response) => {
    if (!response.ok) throw new Error(`Unable to load scroll data: ${response.status}`);
    return response.json();
  }),
  fetch('/data/item-level-ups-gms83-ko.json').then((response) => {
    if (!response.ok) {
      console.warn('Item level-up data unavailable, continuing without it');
      return [];
    }
    return response.json();
  }).catch(() => []),
])
  .then(([scrolls, itemLevelUps]) => {
    scrollIndex = Array.isArray(scrolls) ? scrolls : [];
    scrollsByEquipmentKind = new Map();
    for (const scroll of scrollIndex) {
      const kind = scroll.equipmentKind;
      if (!scrollsByEquipmentKind.has(kind)) {
        scrollsByEquipmentKind.set(kind, []);
      }
      scrollsByEquipmentKind.get(kind).push(scroll);
    }

    itemLevelUpByItemId = new Map(
      (Array.isArray(itemLevelUps) ? itemLevelUps : [])
        .filter((definition) => Number.isInteger(definition.itemId))
        .map((definition) => [definition.itemId, definition]),
    );
    updateLevelUpSourceEligibility();
    renderDeconItemLevel();
    updateTargetCard();
  })
  .catch((error) => {
    console.error(error);
  });
</script>

