// ---- Utility functions (copied from expected-value.astro) ----
const formatRequiredJobs = (requiredJobs = []) => {
  const allJobs = ['초보자', '전사', '마법사', '궁수', '도적', '해적'];
  const equippableSet = new Set(
    (requiredJobs ?? []).length === 0 || (requiredJobs ?? []).includes('Beginner')
      ? allJobs
      : requiredJobs.map((job) => jobKindByRequiredJob[job]).filter(Boolean),
  );

  const row = document.createElement('div');
  row.className = 'selected-item-jobs-row';
  allJobs.forEach((job) => {
    const chip = document.createElement('span');
    chip.className = 'job-chip';
    chip.textContent = job;
    if (!equippableSet.has(job)) {
      chip.classList.add('job-chip--inactive');
    }
    row.append(chip);
  });
  return row;
};

const createItemLine = (label, value, className = '') => {
  const row = document.createElement('div');
  row.className = `selected-item-line ${className}`.trim();
  const labelElement = document.createElement('span');
  labelElement.textContent = label;
  const valueElement = document.createElement('strong');
  valueElement.textContent = String(value);
  row.append(labelElement, document.createTextNode(' : '), valueElement);
  return row;
};

const resolveAttackSpeed = (item) => {
  if (Number.isFinite(item.stats?.attackSpeed)) {
    return item.stats.attackSpeed;
  }
  return weaponAttackSpeedBySubCategory[item.typeInfo?.subCategory] ?? null;
};

const formatStatValue = (key, value) => {
  if (key === 'attackSpeed') {
    const speedLabelByValue = {
      2: '매우 빠름',
      3: '빠름',
      4: '빠름',
      5: '빠름',
      6: '보통',
      7: '느림',
      8: '느림',
      9: '매우 느림',
    };
    return speedLabelByValue[value] ?? '속도 정보 없음';
  }
  if (key === 'upgradeSlots' || value <= 0) {
    return value;
  }
  return `+${value}`;
};

// ---- Render item card with deconstruction deltas ----
const renderTargetItemCard = (item) => {
  if (
    !(selectedItemCard instanceof HTMLElement) ||
    !(selectedItemName instanceof HTMLElement) ||
    !(selectedItemIcon instanceof HTMLImageElement) ||
    !(selectedItemRequirements instanceof HTMLElement) ||
    !(selectedItemStats instanceof HTMLElement)
  ) {
    return;
  }

  selectedItemName.textContent = `${item.nameKo}${deconSlotState.successfulScrollCount > 0 ? ` (+${deconSlotState.successfulScrollCount})` : ''}`;
  selectedItemName.style.color = computeDeconGrade();
  selectedItemIcon.src = buildItemIconUrl(item.id);
  selectedItemRequirements.replaceChildren();
  selectedItemStats.replaceChildren();
  if (selectedItemJobs instanceof HTMLElement) {
    selectedItemJobs.replaceChildren();
    selectedItemJobs.append(formatRequiredJobs(item.requiredJobs));
  }

  requirementRows.forEach(([label, key]) => {
    const value =
      key === 'requiredLevel'
        ? item.requiredLevel
        : (item.requirements?.[key] ?? 0);
    selectedItemRequirements.append(createItemLine(label, value, 'selected-item-line--requirement'));
  });

  const levelUpDef = itemLevelUpByItemId.get(item.id);
  const maxLevelUps = Number.isInteger(levelUpDef?.maxLevelUps) ? levelUpDef.maxLevelUps : 0;
  const alreadyApplied = Math.max(0, Math.min(maxLevelUps, deconAppliedLevelCount));
  const virtualSlots = Array(maxLevelUps).fill(null).map((_, i) => i < alreadyApplied ? { stats: {} } : null);
  const itemLevelUpMeta = computeItemLevelUpCardMeta(
    { itemLevelUpSlots: virtualSlots },
    levelUpDef ?? null,
  );
  if (itemLevelUpMeta) {
    selectedItemRequirements.append(
      createItemLine('ITEM LEV', itemLevelUpMeta.itemLevel, 'selected-item-line--item-level'),
    );
    selectedItemRequirements.append(
      createItemLine('ITEM EXP', itemLevelUpMeta.itemExp, 'selected-item-line--item-level'),
    );
  }

  deconStatRows.forEach(([label, key]) => {
    if (key === 'attackSpeed') {
      const base = resolveAttackSpeed(item);
      if (Number.isFinite(base)) {
        selectedItemStats.append(createItemLine(label, formatStatValue(key, base)));
      }
      return;
    }
    if (key === 'upgradeSlots') {
      selectedItemStats.append(createItemLine(label, deconSlotState.remainingSlots));
      return;
    }
    const base = item.stats?.[key] ?? 0;
    const delta = deconDeltas[key] ?? 0;
    const total = base + delta;
    if (total <= 0) return;
    if (Number.isFinite(total)) {
      if (delta !== 0) {
        if (base === 0) {
          // Stat doesn't exist on base item, show just the delta
          selectedItemStats.append(createItemLine(label, formatStatValue(key, delta)));
        } else {
          // Show breakdown: total (base + delta)
          const deltaFormatted = delta > 0 ? `+${delta}` : String(delta);
          const displayValue = `${formatStatValue(key, total)} (${base}${deltaFormatted})`;
          selectedItemStats.append(createItemLine(label, displayValue));
        }
      } else if (Number.isFinite(base)) {
        selectedItemStats.append(createItemLine(label, formatStatValue(key, base)));
      }
    }
  });

  if (itemPlaceholder instanceof HTMLElement) {
    itemPlaceholder.hidden = true;
  }
  selectedItemCard.hidden = false;
  if (deconStar instanceof HTMLElement) deconStar.hidden = false;
  if (deconCardWrapper instanceof HTMLElement) deconCardWrapper.hidden = false;

  const resetBtn = document.querySelector('[data-enhancement-reset]');
  if (resetBtn instanceof HTMLElement) resetBtn.hidden = false;

  checkDeconStarState();
};

const updateTargetCard = () => {
  if (
