// ---- Item grade color (same thresholds as expected-value calculator) ----
const computeDeconGrade = () => {
  let total = 0;
  for (const [key, value] of Object.entries(deconDeltas)) {
    if (!Number.isFinite(value) || value <= 0) continue;
    total += HP_MP_KEYS.has(key) ? Math.round(value / 10) : value;
  }
  if (total < 0) return '#9e9e9e';
  if (total === 0) return '#ffffff';
  if (total <= 5) return '#ff8c00';
  if (total <= 22) return '#3366ff';
  if (total <= 39) return '#9933ff';
  if (total <= 56) return '#ffd700';
  if (total <= 73) return '#33cc33';
  return '#ff3333';
};

// ---- Stat editor ----
const STAT_ORDER = ['str','dex','int','luk','weaponAttack','magicAttack','maxHp','maxMp','weaponDefense','magicDefense','accuracy','avoidability','speed','jump','attackSpeed','upgradeSlots'];

const equalizeGroupLabels = (container, labelSelector) => {
  if (!(container instanceof HTMLElement)) return;
  const labels = container.querySelectorAll(labelSelector);
  if (labels.length === 0) return;

  // Reset all labels to auto so we measure natural widths
  for (const label of labels) {
    if (label instanceof HTMLElement) {
      label.style.minWidth = '';
    }
  }

  // Measure
  let maxWidth = 0;
  for (const label of labels) {
    const w = label.getBoundingClientRect().width;
    if (w > maxWidth) maxWidth = w;
  }

  // Apply
  const px = Math.ceil(maxWidth) + 'px';
  for (const label of labels) {
    if (label instanceof HTMLElement) {
      label.style.minWidth = px;
    }
  }
};

const rebuildStatEditor = () => {
  if (!(deconStatEditor instanceof HTMLElement)) return;
  deconStatEditor.replaceChildren();

    // Sort keys to match the item card order
    deconStatKeys.sort((a, b) => {
      const ai = STAT_ORDER.indexOf(a);
      const bi = STAT_ORDER.indexOf(b);
      return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
    });

  for (const k of deconStatKeys) {
    // Only init delta for newly-added keys; preserve existing edits
    if (!(k in deconDeltas)) {
      deconDeltas[k] = 0;
    }

    const row = document.createElement('div');
    row.className = 'chaos-stat-row';
    row.dataset.deconStatKey = k;

    const label = document.createElement('span');
    label.className = 'chaos-stat-label';
    label.textContent = statLabelByKey[k] || k;

    const isHpMp = HP_MP_KEYS.has(k);
    const stepSize = isHpMp ? 10 : 1;
    const perScrollMax = isHpMp ? 50 : 5;
    const rangeMax = Math.min(100, deconSlotState.maxSlots * perScrollMax);
    const baseValue = selectedItem?.stats?.[k] ?? 0;
    const rangeMin = -baseValue;

    const minBtn = document.createElement('button');
    minBtn.type = 'button';
    minBtn.className = 'chaos-stepper-btn chaos-stepper-btn--max';
    minBtn.textContent = 'MIN';
    minBtn.addEventListener('click', () => {
      setStatDelta(k, rangeMin);
    });

    const decBtn = document.createElement('button');
    decBtn.type = 'button';
    decBtn.className = 'chaos-stepper-btn';
    decBtn.textContent = '-';
    decBtn.addEventListener('click', () => {
      setStatDelta(k, Math.max(rangeMin, deconDeltas[k] - stepSize));
    });

    const valueInput = document.createElement('input');
    valueInput.type = 'number';
    valueInput.className = 'chaos-stepper-value';
    valueInput.dataset.deconStatValue = k;
    valueInput.value = String(deconDeltas[k] ?? 0);
    valueInput.addEventListener('input', () => {
      const raw = parseInt(valueInput.value, 10);
      if (Number.isFinite(raw)) {
        const clamped = Math.max(rangeMin, Math.min(rangeMax, raw));
        setStatDelta(k, clamped);
        if (clamped !== raw) valueInput.value = String(clamped);
      }
    });

    const incBtn = document.createElement('button');
    incBtn.type = 'button';
    incBtn.className = 'chaos-stepper-btn';
    incBtn.textContent = '+';
    incBtn.addEventListener('click', () => {
      setStatDelta(k, Math.min(rangeMax, deconDeltas[k] + stepSize));
    });

    const maxBtn = document.createElement('button');
    maxBtn.type = 'button';
    maxBtn.className = 'chaos-stepper-btn chaos-stepper-btn--max';
    maxBtn.textContent = 'MAX';
    maxBtn.addEventListener('click', () => {
      setStatDelta(k, rangeMax);
    });

    row.append(label, minBtn, decBtn, valueInput, incBtn, maxBtn);
    deconStatEditor.append(row);
  }

  // Equalize label widths in the 기본 스탯 group
  equalizeGroupLabels(deconStatEditor, '.chaos-stat-label');
  if (deconBasicStatsSep instanceof HTMLElement) deconBasicStatsSep.hidden = false;

  // Populate add-stat menu
  populateAddStatList();
  renderTargetChips();
  updateTargetCard();
  checkDeconStarState();
};

const populateAddStatList = () => {
  if (!(deconAddStatList instanceof HTMLElement)) return;
  deconAddStatList.replaceChildren();

  const deconStatSet = new Set(deconStatKeys);
  let hasOptions = false;

  for (const key of STAT_PRIORITY) {
    if (deconStatSet.has(key)) continue;
    hasOptions = true;

    const row = document.createElement('button');
    row.type = 'button';
    row.className = 'decon-add-stat-option';

    const nameSpan = document.createElement('span');
    nameSpan.textContent = statLabelByKey[key] || key;

    row.append(nameSpan);
    row.addEventListener('click', () => guardDeconMutation(() => {
      deconDeltas[key] = 0;
      deconStatKeys.push(key);
      rebuildStatEditor();
      // Collapse list after selection
      if (deconAddStatList instanceof HTMLElement) deconAddStatList.hidden = true;
      if (deconAddStatToggle instanceof HTMLElement) deconAddStatToggle.classList.remove('decon-add-stat-toggle--open');
    }));

    deconAddStatList.append(row);
  }

  // Hide toggle if no options remain
  if (deconAddStatToggle instanceof HTMLElement) {
    deconAddStatToggle.hidden = !hasOptions;
  }
};

const setStatDelta = (key, value, { skipGuard = false } = {}) => {
  const apply = () => {
    deconDeltas[key] = value;
    const valueInput = document.querySelector(`[data-decon-stat-value="${key}"]`);
    if (valueInput instanceof HTMLInputElement) {
      valueInput.value = String(value);
    }
    updateAnalyzeButton();
    updateTargetCard();
    renderTargetChips();
	    checkDeconStarState();
  };
  if (skipGuard) { apply(); } else { guardDeconMutation(apply); }
};

const updateAnalyzeButton = () => {
  const checkedCount = deconTargetChips?.querySelectorAll('input:checked').length ?? 0;
  const sourceValidationMessage = getSourceValidationMessage(
    getAllowedSources(),
    deconSlotState.successfulScrollCount,
  );
  if (deconSourceMessage instanceof HTMLElement) {
    deconSourceMessage.hidden = sourceValidationMessage === '';
    deconSourceMessage.textContent = sourceValidationMessage;
  }
  if (!(deconAnalyzeBtn instanceof HTMLButtonElement)) return;
  deconAnalyzeBtn.disabled = checkedCount === 0 || sourceValidationMessage !== '';
};

const buildStimulantBoundsEditor = () => {
  if (!(deconStimulantBoundsList instanceof HTMLElement)) return;
  deconStimulantBoundsList.replaceChildren();
  if (!selectedItem) return;
  deconStimulantBoundsMap = {};
  for (const key of deconStatKeys) {
    // Only show stats present on the clean base item with a value > 0.
    // User-added stats (via "+ 스탯 추가") are skipped — stimulant bounds
    // should not apply to stats the item doesn't naturally have.
    const baseVal = selectedItem?.stats?.[key];
    if (!Number.isFinite(baseVal) || baseVal <= 0) continue;

    const isHpMp = HP_MP_KEYS.has(key);
    const defaultLimit = isHpMp ? 50 : 5;
    const stepSize = isHpMp ? 10 : 1;
    deconStimulantBoundsMap[key] = { min: -defaultLimit, max: defaultLimit };

    const row = document.createElement('div');
    row.className = 'decon-secondary-stimulant-row';

    const label = document.createElement('span');
    label.className = 'decon-secondary-stimulant-stat';
    label.textContent = statLabelByKey[key] || key;
    row.append(label);

    // Min slider (full range, auto-swapped if crossed)
    const minSlider = document.createElement('input');
    minSlider.type = 'range';
    minSlider.className = 'decon-secondary-stimulant-slider';
    minSlider.min = -defaultLimit;
    minSlider.max = defaultLimit;
    minSlider.step = stepSize;
    minSlider.value = -defaultLimit;

    const minVal = document.createElement('span');
    minVal.className = 'decon-secondary-stimulant-value';
    minVal.textContent = String(-defaultLimit);

    const sep = document.createElement('span');
    sep.className = 'decon-secondary-stimulant-sep';
    sep.textContent = '~';

    const maxVal = document.createElement('span');
    maxVal.className = 'decon-secondary-stimulant-value';
    maxVal.textContent = String(defaultLimit);

    // Max slider (full range, auto-swapped if crossed)
    const maxSlider = document.createElement('input');
    maxSlider.type = 'range';
    maxSlider.className = 'decon-secondary-stimulant-slider';
    maxSlider.min = -defaultLimit;
    maxSlider.max = defaultLimit;
    maxSlider.step = stepSize;
    maxSlider.value = defaultLimit;

    const updateBounds = () => {
      let mn = Number(minSlider.value);
      let mx = Number(maxSlider.value);
      if (mn > mx) [mn, mx] = [mx, mn];
      deconStimulantBoundsMap[key] = { min: mn, max: mx };
      minSlider.value = mn;
      maxSlider.value = mx;
      minVal.textContent = String(mn);
      maxVal.textContent = String(mx);
    };
    minSlider.addEventListener('input', updateBounds);
    maxSlider.addEventListener('input', updateBounds);
    minSlider.addEventListener('change', () => { checkDeconStarState(); });
    maxSlider.addEventListener('change', () => { checkDeconStarState(); });

    row.append(minSlider, minVal, sep, maxVal, maxSlider);
    deconStimulantBoundsList.append(row);
  }
};

