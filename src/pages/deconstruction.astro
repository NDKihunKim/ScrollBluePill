---
import BaseLayout from '../layouts/BaseLayout.astro';
import { armorKinds, jobKinds, weaponKinds } from '../lib/calculatorInput.mjs';
import { MAPLESTORY_IO_REGION, MAPLESTORY_IO_VERSION } from '../lib/maplestoryIo.mjs';
import '../styles/deconstruction.css';
---

<BaseLayout
  title="아이템 해체분석기"
  description="목표 아이템의 최종 스탯을 만들 수 있는 모든 강화 방법을 찾아냅니다."
>
  <section class="band">
    <div class="container">
      <h1>아이템 해체 분석기</h1>
      <p class="lede">
        목표 아이템의 최종 스탯을 만들 수 있는 모든 강화 방법을 찾아냅니다.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="container grid two">
      <div class="left-stack">
        <form
          class="panel"
          aria-label="주문서 계산 입력"
          data-calculator-input
          data-maplestory-region={MAPLESTORY_IO_REGION}
          data-maplestory-version={MAPLESTORY_IO_VERSION}
        >
          <h2>1. 아이템 검색</h2>
          <div class="item-search-fields">
            <div class="input-row field-block item-name-search" data-item-name-search>
              <label class="field-label" for="item-name-input">아이템 이름</label>
              <input
                id="item-name-input"
                type="search"
                name="itemName"
                placeholder="예: 노가다 목장갑, 노목"
                autocomplete="off"
                aria-autocomplete="list"
                aria-controls="item-suggestion-list"
                aria-expanded="false"
                data-item-name-input
              />
              <input type="hidden" name="itemId" data-selected-item-id />
              <div
                id="item-suggestion-list"
                class="item-suggestion-menu"
                role="listbox"
                aria-label="아이템 검색 결과"
                data-item-suggestions
                hidden
              >
              </div>
            </div>
            <button
              type="button"
              class="manual-search-toggle"
              aria-expanded="false"
              aria-controls="manual-search-fields"
              data-manual-search-toggle
            >
              필터 검색
            </button>
            <div
              id="manual-search-fields"
              class="manual-search-accordion"
              aria-hidden="true"
              data-manual-search-fields
              inert
            >
              <div class="manual-search-accordion-inner">
                <fieldset class="input-row job-options">
                  <div class="field-header">
                    <legend>직업</legend>
                    <div class="compact-actions">
                      <button type="button" class="small-button secondary" data-job-select-all>전체 선택</button>
                      <button type="button" class="small-button secondary" data-job-clear-all>전체 해제</button>
                    </div>
                  </div>
                  <div class="choice-row">
                    {
                      jobKinds.map((job) => (
                        <label class="choice-button">
                          <input type="checkbox" name="jobs" value={job} checked hidden />
                          <span>{job}</span>
                        </label>
                      ))
                    }
                  </div>
                </fieldset>
                <div class="input-row field-block equipment-block">
                  <div class="field-header">
                    <span id="equipment-kind-label" class="field-label">장비 종류</span>
                    <div class="segmented-control" aria-label="장비 종류 범위">
                      <button type="button" class="segment" data-equipment-mode="weapon">무기</button>
                      <button type="button" class="segment" data-equipment-mode="armor">장비</button>
                    </div>
                  </div>
                  <input type="hidden" name="equipmentKind" value="" data-equipment-kind />
                  <div class="dropdown-frame" data-equipment-dropdown>
                    <button
                      type="button"
                      class="dropdown-trigger"
                      aria-expanded="false"
                      aria-haspopup="listbox"
                      aria-labelledby="equipment-kind-label"
                      data-equipment-trigger
                    >
                      <span data-equipment-trigger-label>장비 종류를 먼저 골라주세요</span>
                      <span aria-hidden="true">⌄</span>
                    </button>
                    <div class="equipment-menu" role="listbox" aria-labelledby="equipment-kind-label" data-equipment-menu hidden>
                      <div data-equipment-options="weapon" hidden>
                      {
                        weaponKinds.map((kind, index) => (
                          <button
                            type="button"
                            class='equipment-option'
                            data-equipment-option={kind}
                            role="option"
                            aria-selected='false'
                          >
                            {kind}
                          </button>
                        ))
                      }
                      </div>
                      <div data-equipment-options="armor" hidden>
                      {
                        armorKinds.map((kind) => (
                          <button type="button" class="equipment-option" data-equipment-option={kind} role="option" aria-selected="false">
                            {kind}
                          </button>
                        ))
                      }
                      </div>
                    </div>
                  </div>
                  <div class="input-row field-block level-range-block">
                    <span class="field-label">아이템 요구 레벨</span>
                    <div class="level-range-control">
                      <span class="level-stepper">
                        <button type="button" class="step-button" data-level-bound="min" data-level-step="-5" aria-label="최소 요구 레벨 5 감소">
                          -5
                        </button>
                        <input
                          type="number"
                          name="requiredLevelMin"
                          value="0"
                          min="0"
                          step="5"
                          inputmode="numeric"
                          aria-label="최소 요구 레벨"
                          data-level-input
                          data-level-min-input
                        />
                        <button type="button" class="step-button" data-level-bound="min" data-level-step="5" aria-label="최소 요구 레벨 5 증가">
                          +5
                        </button>
                      </span>
                      <span class="level-range-separator" aria-hidden="true">-</span>
                      <span class="level-stepper">
                        <button type="button" class="step-button" data-level-bound="max" data-level-step="-5" aria-label="최대 요구 레벨 5 감소">
                          -5
                        </button>
                        <input
                          type="number"
                          name="requiredLevelMax"
                          value="200"
                          min="0"
                          step="5"
                          inputmode="numeric"
                          aria-label="최대 요구 레벨"
                          data-level-input
                          data-level-max-input
                        />
                        <button type="button" class="step-button" data-level-bound="max" data-level-step="5" aria-label="최대 요구 레벨 5 증가">
                          +5
                        </button>
                      </span>
                    </div>
                  </div>
                  <div class="manual-item-results" data-manual-item-results hidden></div>
                </div>
              </div>
            </div>
          </div>
        </form>

        <section class="calculator-panel calc-panel" data-decon-edit-panel>
          <h2>2. 스탯 편집</h2>
          <p class="enhancement-placeholder" data-decon-edit-placeholder>
            먼저 위에서 아이템을 선택해주세요
          </p>
          <div data-decon-edit-content hidden>
            <p class="decon-stat-group-title">기본 스탯</p>
            <div class="decon-stat-editor" data-decon-stat-editor></div>
            <hr class="decon-stat-group-sep" data-decon-basic-stats-sep hidden />
            <p class="decon-stat-group-title" data-decon-item-info-title hidden>아이템 정보</p>
            <div class="chaos-stat-row decon-success-row" data-decon-success-row>
              <span class="chaos-stat-label">주문서 성공 횟수</span>
              <button type="button" class="chaos-stepper-btn chaos-stepper-btn--max" data-decon-success-min>MIN</button>
              <button type="button" class="chaos-stepper-btn" data-decon-success-dec>−</button>
              <span class="chaos-stepper-value" data-decon-success-value>0</span>
              <button type="button" class="chaos-stepper-btn" data-decon-success-inc>+</button>
              <button type="button" class="chaos-stepper-btn chaos-stepper-btn--max" data-decon-success-max>MAX</button>
            </div>
            <div class="chaos-stat-row decon-slot-row">
              <span class="chaos-stat-label">남은 슬롯</span>
              <button type="button" class="chaos-stepper-btn chaos-stepper-btn--max" data-decon-slot-min>MIN</button>
              <button type="button" class="chaos-stepper-btn" data-decon-slot-dec>−</button>
              <span class="chaos-stepper-value" data-decon-slot-value>7</span>
              <button type="button" class="chaos-stepper-btn" data-decon-slot-inc>+</button>
              <button type="button" class="chaos-stepper-btn chaos-stepper-btn--max" data-decon-slot-max>MAX</button>
            </div>
            <div class="chaos-stat-row decon-level-row" data-decon-level-row hidden>
              <span class="chaos-stat-label">아이템 레벨</span>
              <button type="button" class="chaos-stepper-btn chaos-stepper-btn--max" data-decon-level-min>MIN</button>
              <button type="button" class="chaos-stepper-btn" data-decon-level-dec>−</button>
              <span class="chaos-stepper-value" data-decon-level-value>1</span>
              <button type="button" class="chaos-stepper-btn" data-decon-level-inc>+</button>
              <button type="button" class="chaos-stepper-btn chaos-stepper-btn--max" data-decon-level-max>MAX</button>
            </div>
            <hr class="decon-stat-group-sep" data-decon-item-info-sep hidden />
            <div class="decon-add-stat-area">
              <button type="button" class="decon-add-stat-toggle" data-decon-add-stat-toggle>
                + 스탯 추가
              </button>
              <div class="decon-add-stat-list" data-decon-add-stat-list hidden>
              </div>
            </div>
          </div>
        </section>

        <section class="calculator-panel calc-panel" data-decon-calc-panel>
          <h2>3. 계산</h2>
          <p class="enhancement-placeholder" data-decon-calc-placeholder>
            스탯 편집 후 목표 조건을 선택해주세요
          </p>
          <div data-decon-calc-content hidden>
            <div class="ev-target-chip-grid" data-decon-target-chips></div>
            <fieldset class="decon-source-options" aria-describedby="decon-source-message">
              <legend>분석에 사용할 강화 유형</legend>
              <div class="decon-source-accordion">
                <div class="decon-source-row">
                  <label class="ev-target-chip">
                    <input type="checkbox" data-decon-source="scrolls" />
                    <span class="ev-target-chip-label">주문서</span>
                  </label>
                  <div class="decon-source-sub" data-decon-scroll-rate-sub>
                    <span class="decon-source-sub-label">스크롤 등급:</span>
                    <label class="decon-rate-chip"><input type="checkbox" data-decon-scroll-rate="100" checked />100%</label>
                    <label class="decon-rate-chip"><input type="checkbox" data-decon-scroll-rate="60" checked />60%</label>
                    <label class="decon-rate-chip"><input type="checkbox" data-decon-scroll-rate="10" checked />10%</label>
                    <label class="decon-rate-chip"><input type="checkbox" data-decon-scroll-rate="chaos" />혼돈의 주문서<span class="decon-chaos-help"><span class="decon-chaos-help-icon">?</span><span class="decon-chaos-help-tooltip">일반 주문서와의 조합이 불가능 할경우 사용됩니다.</span></span></label>
                  </div>
                  <div class="decon-source-sub" data-decon-chaos-bounds hidden>
                    <span class="decon-source-sub-label">혼줌 스텟 범위:</span>
                    <div data-decon-chaos-bounds-list></div>
                  </div>
                </div>
                <div class="decon-source-row">
                  <label class="ev-target-chip">
                    <input type="checkbox" data-decon-source="stimulant" />
                    <span class="ev-target-chip-label" data-decon-stimulant-label>촉진제/추옵</span>
                  </label>
                  <div class="decon-source-sub" data-decon-stimulant-bounds>
                    <span class="decon-source-sub-label">스탯 범위:</span>
                    <div data-decon-stimulant-bounds-list></div>
                  </div>
                </div>
                <div class="decon-source-row" data-decon-gems-row>
                  <label class="ev-target-chip">
                    <input type="checkbox" data-decon-source="gems" />
                    <span class="ev-target-chip-label">메이커 보석</span>
                  </label>
                  <div class="decon-source-sub" data-decon-gem-sub></div>
                </div>
                <div class="decon-source-row" data-decon-level-up-source hidden>
                  <label class="ev-target-chip">
                    <input type="checkbox" data-decon-source="itemLevelUp" />
                    <span class="ev-target-chip-label">레벨업</span>
                  </label>
                  <div class="decon-source-sub" data-decon-level-slot-ranges hidden>
                    <span class="decon-source-sub-label" data-decon-level-slot-label></span>
                    <div data-decon-level-slot-list></div>
                  </div>
                </div>
              </div>
            </fieldset>
            <p
              id="decon-source-message"
              class="decon-source-message"
              data-decon-source-message
              aria-live="polite"
              hidden
            ></p>
            <button type="button" class="ev-start-btn" data-decon-analyze-btn disabled>
              분석 시작
            </button>
          </div>
        </section>

        <section class="calculator-panel result-panel" data-decon-result-panel>
          <h2>4. 해체 분석 결과</h2>
          <p class="enhancement-placeholder" data-decon-result-placeholder>
            스탯 편집 후 분석 시작을 눌러주세요
          </p>
          <div data-decon-result-content hidden>
            <div class="decon-filter-chips" data-decon-filter-chips></div>
            <div class="decon-secondary-filters" data-decon-secondary-filters hidden></div>
            <div class="decon-strategy-list" data-decon-strategy-list></div>
          </div>
        </section>
      </div>

      <aside class="panel" aria-label="아이템 미리보기">
        <h2>아이템 미리보기</h2>
        <div class="item-slot-bar" data-decon-slot-bar></div>
        <p class="enhancement-placeholder" data-item-placeholder>아이템을 선택해주세요</p>
        <div data-selected-item-card-wrapper style="position:relative;">
          <button type="button" class="item-card-star" data-decon-star hidden title="슬롯에 저장">☆</button>
          <div class="selected-item-card" data-selected-item-card hidden>
          <h3 data-selected-item-name></h3>
          <div class="selected-item-top">
            <div class="selected-item-icon-frame">
              <img data-selected-item-icon alt="" />
            </div>
            <div class="selected-item-requirements" data-selected-item-requirements></div>
          </div>
          <div class="selected-item-jobs" data-selected-item-jobs></div>
          <div class="selected-item-divider"></div>
          <div class="selected-item-stats" data-selected-item-stats></div>
        </div>
        </div>
        <button type="button" class="small-button secondary selected-item-reset" data-enhancement-reset hidden>
          초기화
        </button>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
import { searchKoreanItems } from '../lib/itemSearch.mjs';
import { buildItemIconUrl, buildItemSearchUrl } from '../lib/maplestoryIo.mjs';
import { HP_MP_KEYS, computeItemLevelUpCardMeta } from '../lib/enhancementState.mjs';
import { enumerateStrategies } from '../lib/deconstruction/engine.mjs';
import { guardCheckboxMutation } from '../lib/deconstruction/guardedCheckboxMutation.mjs';
import { GEM_GRADES, GEM_ITEM_IDS, GEM_TYPES, isWeaponKind, computeGemSlotCount } from '../lib/makerData.mjs';
import {
  createDeconstructionSlotState,
  setSuccessfulScrollCount,
  setRemainingSlotCount,
} from '../lib/deconstruction/slotState.mjs';
import {
  getDefaultSourceSelection,
  getSourceValidationMessage,
  resolveAllowedSources,
} from '../lib/deconstruction/sourcePolicy.mjs';
import {
  createResultFilterController,
} from '../lib/deconstruction/resultFilterController.mjs';
import { readSlots, saveToSlot, clearSlot, findMatchingSlot, MAX_SLOTS } from '../lib/itemSlotStore.mjs';
import { dom } from '../lib/deconstruction/domRefs.mjs';

const {
  form, itemNameSearch, itemNameInput, selectedItemIdInput, itemSuggestions,
  selectedItemCard, itemPlaceholder, selectedItemName, selectedItemIcon,
  selectedItemRequirements, selectedItemStats, selectedItemJobs,
  levelInputs, levelMinInput, levelMaxInput, stepButtons,
  equipmentInput, equipmentDropdown, equipmentTrigger, equipmentTriggerLabel,
  equipmentMenu, equipmentModeButtons, equipmentOptionGroups, equipmentOptionButtons,
  manualSearchToggle, manualSearchFields, manualSearchAccordionInner, manualItemResults,
  jobInputs, jobSelectAllButton, jobClearAllButton,
  deconEditPanel, deconEditPlaceholder, deconEditContent,
  deconStatEditor,
  deconSuccessValue, deconSuccessMin, deconSuccessDec, deconSuccessInc, deconSuccessMax,
  deconSlotValue, deconSlotMin, deconSlotDec, deconSlotInc, deconSlotMax,
  deconAnalyzeBtn, deconAddStatToggle, deconAddStatList,
  deconBasicStatsSep, deconItemInfoTitle, deconItemInfoSep,
  deconResultPanel, deconResultPlaceholder, deconResultContent,
  deconCalcPanel, deconCalcPlaceholder, deconCalcContent, deconTargetChips,
  deconScrollSource, deconStimulantSource, deconStimulantLabel,
  deconGemsSource, deconGemsRow, deconGemSub,
  deconItemLevelUpSource, deconLevelUpSource, deconLevelRow,
  deconLevelMinBtn, deconLevelDecBtn, deconLevelIncBtn, deconLevelMaxBtn, deconLevelValue,
  deconScrollRateSub, deconScrollRateInputs,
  deconStimulantBounds, deconStimulantBoundsList,
  deconChaosBounds, deconChaosBoundsList,
  deconLevelSlotRanges, deconLevelSlotList, deconLevelSlotLabel,
  deconSourceMessage, deconSecondaryFilters, deconSlotBar, deconStar, deconCardWrapper,
} = dom;

// ---- Helpers ----

/**
 * Strip the equipment prefix from chaos scroll names.
 * "장갑 혼돈의 주문서" → "혼돈의 주문서"
 * "장갑 민첩의 주문서" → unchanged (not a chaos scroll)
 */
function simplifyScrollDisplayName(nameKo) {
  const match = String(nameKo ?? '').match(/(혼돈의 주문서.*)$/);
  return match ? match[1] : nameKo;
}

const resultFilterController = createResultFilterController({
  root: document,
  secondaryContainer: deconSecondaryFilters,
});

const toggleSourceSub = (sourceCheckbox, subContainer, onFirstEnable) => {
  if (!(sourceCheckbox instanceof HTMLInputElement) || !(subContainer instanceof HTMLElement)) return;
  const enabled = sourceCheckbox.checked;
  if (enabled) subContainer.hidden = false;
  subContainer.classList.toggle('decon-source-sub--open', enabled);
  if (enabled && typeof onFirstEnable === 'function') onFirstEnable();
};

// ---- State ----
let itemIndex = [];
let itemById = new Map();
let scrollIndex = [];
let scrollsByEquipmentKind = new Map();
let selectedItem = null;
let deconDeltas = {};
let deconStatKeys = [];
let deconSlotState = createDeconstructionSlotState(0);
let deconHasActionableResults = false;
let deconScrollRateFilter = new Set(['100', '60', '10']);
let deconStimulantBoundsMap = {};
let deconChaosBoundsMap = {};
let deconGemFilter = null; // null = all gems available, Set<string> of "gemKey:gradeIndex" = whitelist
let deconGemEligible = true; // whether selected item meets maker gem REQLEV threshold for its class
let deconLevelUpTotalRanges = {};
let deconAppliedLevelCount = 0;      // how many level-ups are already applied (0..maxLevelUps)

const guardDeconMutation = (fn) => {
  if (!deconHasActionableResults) { fn(); return; }
  showDeconConfirmDialog(() => {
    deconHasActionableResults = false;
    if (deconResultPlaceholder instanceof HTMLElement) deconResultPlaceholder.hidden = false;
    if (deconResultContent instanceof HTMLElement) deconResultContent.hidden = true;
    fn();
  });
};

const STAT_PRIORITY = ['weaponAttack', 'magicAttack', 'str', 'dex', 'int', 'luk', 'maxHp', 'maxMp', 'weaponDefense', 'magicDefense', 'accuracy', 'avoidability', 'speed', 'jump'];

const statLabelByKey = {
  weaponAttack: '공격력', magicAttack: '마력', str: 'STR', dex: 'DEX', int: 'INT', luk: 'LUK',
  maxHp: '최대HP', maxMp: '최대MP', weaponDefense: '물리방어력', magicDefense: '마법방어력',
  accuracy: '명중률', avoidability: '회피율', speed: '이동속도', jump: '점프력',
};

const CORE_STATS = new Set(['str', 'dex', 'int', 'luk', 'weaponAttack', 'magicAttack']);

const getAllowedSources = () => resolveAllowedSources(
  {
    scrolls: deconScrollSource instanceof HTMLInputElement && deconScrollSource.checked,
    stimulant: deconStimulantSource instanceof HTMLInputElement && deconStimulantSource.checked,
    gems: deconGemsSource instanceof HTMLInputElement && deconGemsSource.checked,
    itemLevelUp: deconItemLevelUpSource instanceof HTMLInputElement && deconItemLevelUpSource.checked,
  },
  {
    itemLevelUpEligible:
      deconLevelUpSource instanceof HTMLElement && !deconLevelUpSource.hidden && getDeconItemLevelSourceEligibility(),
  },
);

const resetAllowedSources = () => {
  const defaults = getDefaultSourceSelection();
  if (deconScrollSource instanceof HTMLInputElement) deconScrollSource.checked = defaults.scrolls;
  if (deconStimulantSource instanceof HTMLInputElement) deconStimulantSource.checked = defaults.stimulant;
  if (deconGemsSource instanceof HTMLInputElement) deconGemsSource.checked = defaults.gems;
  if (deconItemLevelUpSource instanceof HTMLInputElement) {
    deconItemLevelUpSource.checked = defaults.itemLevelUp;
  }
  // Collapse all source sub-sections since programmatic .checked
  // changes don't fire the change event that toggleSourceSub needs.
  const allSubs = [deconScrollRateSub, deconStimulantBounds, deconGemSub, deconLevelSlotRanges, deconChaosBounds];
  for (const sub of allSubs) {
    if (sub instanceof HTMLElement) {
      sub.classList.remove('decon-source-sub--open');
      sub.hidden = true;
    }
  }
  // Refresh source panel visibility based on current item's gem eligibility
  updateSourcePanelForItem(selectedItem);
};

const getDeconItemLevelSourceEligibility = () => {
  if (!selectedItem) return false;
  const def = itemLevelUpByItemId.get(selectedItem.id);
  if (!def) return false;
  return true;
};

const updateLevelUpSourceEligibility = () => {
  if (!(deconLevelUpSource instanceof HTMLElement)) return;
  deconLevelUpSource.hidden = !selectedItem || !itemLevelUpByItemId.has(selectedItem.id);
  // Disable 레벨업 checkbox until user changes 아이템 레벨 from default
  if (deconItemLevelUpSource instanceof HTMLInputElement) {
    deconItemLevelUpSource.disabled = deconAppliedLevelCount === 0;
  }
  updateAnalyzeButton();
};

const updateSourcePanelForItem = (item) => {
  if (!item) {
    deconGemEligible = true;
    if (deconGemsRow instanceof HTMLElement) deconGemsRow.hidden = false;
    if (deconStimulantLabel instanceof HTMLElement) deconStimulantLabel.textContent = '촉진제/추옵';
    return;
  }
  const eligible = computeGemSlotCount(item.requiredLevel ?? 0, item.requiredJobs ?? []) > 0;
  deconGemEligible = eligible;

  // Hide gems source row when item is not maker-gem-eligible
  if (deconGemsRow instanceof HTMLElement) {
    deconGemsRow.hidden = !eligible;
  }

  // Update stimulant label: non-maker items use "추가 옵션" instead of "촉진제/추옵"
  if (deconStimulantLabel instanceof HTMLElement) {
    deconStimulantLabel.textContent = eligible ? '촉진제/추옵' : '추가 옵션';
  }

  // If gems are not eligible and the checkbox was checked, uncheck it and collapse sub-panel
  if (!eligible && deconGemsSource instanceof HTMLInputElement && deconGemsSource.checked) {
    deconGemsSource.checked = false;
    deconGemFilter = null;
    if (deconGemSub instanceof HTMLElement) {
      deconGemSub.classList.remove('decon-source-sub--open');
      deconGemSub.hidden = true;
    }
  }

  updateAnalyzeButton();
};

// Source checkbox change handlers are consolidated below with guardCheckboxMutation
// to ensure accordion panels only toggle after user confirmation when results exist.

const renderTargetChips = () => {
  if (!(deconTargetChips instanceof HTMLElement)) return;
  deconTargetChips.replaceChildren();

  let anyChecked = false;

  // Collect all keys: base item stats + deltas
  const allKeys = new Set([
    ...Object.keys(selectedItem?.stats ?? {}),
    ...deconStatKeys.filter(k => deconDeltas[k] !== 0),
  ]);

  // Sort by card order
  const sortedKeys = [...allKeys].sort((a, b) => {
    const ai = STAT_ORDER.indexOf(a);
    const bi = STAT_ORDER.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  });

  for (const key of sortedKeys) {
    if (key === 'attackSpeed' || key === 'upgradeSlots') continue;

    const isCore = CORE_STATS.has(key);
    const delta = deconDeltas[key] ?? 0;

    // Core: visible if on base item OR has delta
    // Non-core: visible only if has non-zero delta
    if (!isCore && delta === 0) continue;

    const label = document.createElement('label');
    label.className = 'ev-target-chip';

    const checkbox = document.createElement('input');
    checkbox.type = 'checkbox';
    checkbox.dataset.deconTargetKey = key;
    checkbox.checked = delta !== 0; // checked only if stat has a delta
    if (checkbox.checked) anyChecked = true;

    checkbox.addEventListener('change', () => {
      guardCheckboxMutation(checkbox, guardDeconMutation, updateAnalyzeButton);
    });

    const chipLabel = document.createElement('span');
    chipLabel.className = 'ev-target-chip-label';
    const displayName = statLabelByKey[key] || key;
    chipLabel.textContent = delta !== 0
      ? `${displayName} ${delta > 0 ? '+' : ''}${delta}`
      : `${displayName} 유지`;

    label.append(checkbox, chipLabel);
    deconTargetChips.append(label);
  }

  updateAnalyzeButton();
};

