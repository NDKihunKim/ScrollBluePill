    for (const gem of GEM_TYPES) {
      if (gem.weaponOnly && !isWeaponKind(equipmentKind)) continue;
      for (let gi = 0; gi < GEM_GRADES.length; gi++) {
        deconGemFilter.add(`${gem.key}:${gi}`);
      }
    }
  }

  // ---- persistent header (stays when navigating to grade view) ----
  deconGemSub.replaceChildren();

  const topRow = document.createElement('div');
  topRow.className = 'decon-gem-top-row';

  const label = document.createElement('p');
  label.className = 'decon-gem-picker-label';
  label.textContent = '보석 종류 선택';
  topRow.append(label);

  const actions = document.createElement('div');
  actions.className = 'decon-gem-actions';

  let currentGradeGem = null; // set when viewing a specific gem's grades

  const selectAllBtn = document.createElement('button');
  selectAllBtn.type = 'button';
  selectAllBtn.className = 'decon-gem-action-btn';
  selectAllBtn.textContent = '전체 선택';
  selectAllBtn.addEventListener('click', () => {
    if (currentGradeGem) {
      // In grade view: select all grades of current gem only
      for (let gi = 0; gi < GEM_GRADES.length; gi++) {
        deconGemFilter.add(`${currentGradeGem.key}:${gi}`);
      }
      renderGrades(currentGradeGem);
	      checkDeconStarState();
    } else {
      // In category view: select all gems and grades
      for (const g of GEM_TYPES) {
        if (g.weaponOnly && !isWeaponKind(equipmentKind)) continue;
        for (let gi = 0; gi < GEM_GRADES.length; gi++) {
          deconGemFilter.add(`${g.key}:${gi}`);
        }
      }
      renderCategories();
	      checkDeconStarState();
    }
  });
  actions.append(selectAllBtn);

  const deselectAllBtn = document.createElement('button');
  deselectAllBtn.type = 'button';
  deselectAllBtn.className = 'decon-gem-action-btn';
  deselectAllBtn.textContent = '전체 해제';
  deselectAllBtn.addEventListener('click', () => {
    if (currentGradeGem) {
      // In grade view: deselect all grades of current gem only
      for (let gi = 0; gi < GEM_GRADES.length; gi++) {
        deconGemFilter.delete(`${currentGradeGem.key}:${gi}`);
      }
	      checkDeconStarState();
      renderGrades(currentGradeGem);
    } else {
      // In category view: deselect all gems and grades
      for (const g of GEM_TYPES) {
        if (g.weaponOnly && !isWeaponKind(equipmentKind)) continue;
        for (let gi = 0; gi < GEM_GRADES.length; gi++) {
          deconGemFilter.delete(`${g.key}:${gi}`);
        }
	      checkDeconStarState();
      }
      renderCategories();
    }
  });
  actions.append(deselectAllBtn);

  topRow.append(actions);
  deconGemSub.append(topRow);

  // ---- replaceable content area ----
  const contentArea = document.createElement('div');
  contentArea.className = 'decon-gem-content';
  deconGemSub.append(contentArea);

  const renderCategories = () => {
    currentGradeGem = null;
    contentArea.replaceChildren();

    const grid = document.createElement('div');
    grid.className = 'decon-gem-grid';

    for (const gem of GEM_TYPES) {
      if (gem.weaponOnly && !isWeaponKind(equipmentKind)) continue;

      const card = document.createElement('button');
      card.type = 'button';
      card.className = 'decon-gem-category';

      // Highlight if at least one grade is selected
      let hasSelectedGrade = false;
      for (let gi = 0; gi < GEM_GRADES.length; gi++) {
        if (deconGemFilter.has(`${gem.key}:${gi}`)) {
          hasSelectedGrade = true;
          break;
        }
      }
      if (hasSelectedGrade) card.classList.add('decon-gem-category--selected');

      const baseId = GEM_ITEM_IDS[gem.key]?.base;
      if (baseId) {
        const icon = document.createElement('img');
        icon.src = buildItemIconUrl(baseId);
        icon.alt = '';
        icon.loading = 'lazy';
        card.append(icon);
      }

      const name = document.createElement('span');
      name.textContent = gem.nameKo;
      card.append(name);

      if (gem.key !== 'darkCrystal') {
        const statSub = document.createElement('span');
        statSub.className = 'decon-gem-category-stat';
        if (gem.behavior === 'variable') {
          const keyLabels = (gem.variableKeys ?? []).map((k) => statLabelByKey[k] ?? k);
          statSub.textContent = `(${keyLabels.join('/')})`;
        } else {
          statSub.textContent = `(${statLabelByKey[gem.stat] ?? gem.stat})`;
        }
        card.append(statSub);
      }

      card.addEventListener('click', () => renderGrades(gem));
      grid.append(card);
    }

    contentArea.append(grid);

  };

  const renderGrades = (gem) => {
    currentGradeGem = gem;
    contentArea.replaceChildren();

    const header = document.createElement('div');
    header.className = 'decon-gem-picker-header';

    const backBtn = document.createElement('button');
    backBtn.type = 'button';
    backBtn.className = 'decon-gem-back';
    backBtn.textContent = '← 뒤로';
    backBtn.addEventListener('click', renderCategories);
    header.append(backBtn);

    const baseId = GEM_ITEM_IDS[gem.key]?.base;
    if (baseId) {
      const icon = document.createElement('img');
      icon.src = buildItemIconUrl(baseId);
      icon.alt = '';
      icon.loading = 'lazy';
      header.append(icon);
    }

    const nameEl = document.createElement('span');
    nameEl.className = 'decon-gem-name';
    nameEl.textContent = gem.nameKo;
    header.append(nameEl);

    contentArea.append(header);

    const gradesList = document.createElement('div');
    gradesList.className = 'decon-gem-grades';

    for (let gradeIndex = 0; gradeIndex < GEM_GRADES.length; gradeIndex++) {
      const gradeLabel = GEM_GRADES[gradeIndex];

      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'decon-gem-grade';

      const filterKey = `${gem.key}:${gradeIndex}`;
      const isSelected = deconGemFilter?.has(filterKey) ?? true;
      if (isSelected) row.classList.add('decon-gem-grade--selected');

      const gradeKey = ['low', 'mid', 'high'][gradeIndex];
      const gradeIconId = GEM_ITEM_IDS[gem.key]?.[gradeKey];
      if (gradeIconId) {
        const gradeIcon = document.createElement('img');
        gradeIcon.src = buildItemIconUrl(gradeIconId);
        gradeIcon.alt = '';
        gradeIcon.loading = 'lazy';
        row.append(gradeIcon);
      }

      // Grade name span (matching maker-picker-item: normal weight, card font)
      const gradeName = document.createElement('span');
      gradeName.textContent = gradeLabel;
      row.append(gradeName);

      // Stat value or range span (matching .maker-picker-item-stat)
      const statSpan = document.createElement('span');
      statSpan.className = 'decon-gem-category-stat';
      if (gem.stat && gem.values) {
        // Fixed-stat gem: e.g. "STR +1"
        const val = gem.values[gradeIndex];
        const dispLabel = statLabelByKey[gem.stat] || gem.stat;
        statSpan.textContent = `${dispLabel} +${val}`;
      } else if (gem.behavior === 'variable') {
        // Variable gem: show delta range per grade
        const isDark = gem.key === 'darkCrystal';
        const ranges = isDark
          ? ['-2 ~ +2', '-3 ~ +3', '-5 ~ +5']
          : ['-1 ~ +1', '-2 ~ +2', '-3 ~ +3'];
        statSpan.textContent = ranges[gradeIndex];
      }
      row.append(statSpan);

      // Click to toggle selection
      row.addEventListener('click', () => {
        guardDeconMutation(() => {
          if (deconGemFilter.has(filterKey)) {
            deconGemFilter.delete(filterKey);
            row.classList.remove('decon-gem-grade--selected');
          } else {
            deconGemFilter.add(filterKey);
            row.classList.add('decon-gem-grade--selected');
          }
          checkDeconStarState();
        });
      });

      gradesList.append(row);
    }

    contentArea.append(gradesList);

	  checkDeconStarState();
  };

  renderCategories();
};

const buildLevelUpSlotEditors = () => {
  if (!(deconLevelSlotList instanceof HTMLElement) || !(deconLevelSlotLabel instanceof HTMLElement)) return;
  deconLevelSlotList.replaceChildren();
  if (!selectedItem) return;
  const def = itemLevelUpByItemId.get(selectedItem.id);
  const maxLevelUps = Number.isInteger(def?.maxLevelUps) ? def.maxLevelUps : 0;
  if (maxLevelUps <= 0) return;

  const statRanges = def?.statRanges ?? {};
  const applied = deconAppliedLevelCount;

  if (applied <= 0) {
    deconLevelSlotLabel.textContent = '아이템 레벨 +1 이상 설정 시 레벨업 총합 범위를 입력할 수 있습니다.';
    deconLevelUpTotalRanges = {};
    return;
  }

  deconLevelSlotLabel.textContent = `아이템 레벨 +${applied} 레벨업 총합 범위:`;

  const slot = document.createElement('div');
  slot.className = 'decon-level-slot';
  slot.setAttribute('data-decon-level-total-range', String(applied));

  const statsRow = document.createElement('div');
  statsRow.className = 'decon-level-slot-stats';

  for (const key of Object.keys(statRanges)) {
    const defRange = statRanges[key] ?? { min: 0, max: 0 };
    const totalMin = defRange.min * applied;
    const totalMax = defRange.max * applied;
    if (!deconLevelUpTotalRanges[key]) {
      deconLevelUpTotalRanges[key] = { min: totalMin, max: totalMax };
    }

    const range = deconLevelUpTotalRanges[key];

    // Row — reuses stimulant CSS for visual consistency
    const row = document.createElement('div');
    row.className = 'decon-secondary-stimulant-row';

    const label = document.createElement('span');
    label.className = 'decon-secondary-stimulant-stat';
    label.textContent = statLabelByKey[key] || key;
    row.append(label);

    // Min slider
    const minSlider = document.createElement('input');
    minSlider.type = 'range';
    minSlider.className = 'decon-secondary-stimulant-slider';
    minSlider.min = totalMin;
    minSlider.max = totalMax;
    minSlider.step = 1;
    minSlider.value = range.min;

    const minVal = document.createElement('span');
    minVal.className = 'decon-secondary-stimulant-value';
    minVal.textContent = String(range.min);

    const sep = document.createElement('span');
    sep.className = 'decon-secondary-stimulant-sep';
    sep.textContent = '~';

    const maxVal = document.createElement('span');
    maxVal.className = 'decon-secondary-stimulant-value';
    maxVal.textContent = String(range.max);

    // Max slider
    const maxSlider = document.createElement('input');
    maxSlider.type = 'range';
    maxSlider.className = 'decon-secondary-stimulant-slider';
    maxSlider.min = totalMin;
    maxSlider.max = totalMax;
    maxSlider.step = 1;
    maxSlider.value = range.max;

    // ---- event handlers (mirror stimulant editor pattern) ----
    minSlider.addEventListener('input', () => {
      const val = Number(minSlider.value);
      minVal.textContent = String(val);
      // Enforce min ≤ max
      const clamped = Math.min(val, deconLevelUpTotalRanges[key].max);
      deconLevelUpTotalRanges[key] = { ...deconLevelUpTotalRanges[key], min: clamped };
    });
    minSlider.addEventListener('change', () => {
      const val = Number(minSlider.value);
      const clamped = Math.min(val, deconLevelUpTotalRanges[key].max);
      deconLevelUpTotalRanges[key] = { ...deconLevelUpTotalRanges[key], min: clamped };
      minSlider.value = clamped;
      minVal.textContent = String(clamped);
      checkDeconStarState();
    });

    maxSlider.addEventListener('input', () => {
      const val = Number(maxSlider.value);
      maxVal.textContent = String(val);
      // Enforce max ≥ min
      const clamped = Math.max(val, deconLevelUpTotalRanges[key].min);
      deconLevelUpTotalRanges[key] = { ...deconLevelUpTotalRanges[key], max: clamped };
    });
    maxSlider.addEventListener('change', () => {
      const val = Number(maxSlider.value);
      const clamped = Math.max(val, deconLevelUpTotalRanges[key].min);
      deconLevelUpTotalRanges[key] = { ...deconLevelUpTotalRanges[key], max: clamped };
      maxSlider.value = clamped;
      maxVal.textContent = String(clamped);
      checkDeconStarState();
    });

    row.append(minSlider, minVal, sep, maxVal, maxSlider);
    statsRow.append(row);
  }

  slot.append(statsRow);
  deconLevelSlotList.append(slot);
};

const renderDeconSlotState = () => {
  if (deconSuccessValue instanceof HTMLElement) {
    deconSuccessValue.textContent = String(deconSlotState.successfulScrollCount);
  }
  if (deconSlotValue instanceof HTMLElement) {
    deconSlotValue.textContent = String(deconSlotState.remainingSlots);
  }
  updateTargetCard();
  updateAnalyzeButton();
  equalizeGroupLabels(deconEditContent, '.decon-success-row > .chaos-stat-label, .decon-slot-row > .chaos-stat-label, .decon-level-row:not([hidden]) > .chaos-stat-label');
  if (deconItemInfoTitle instanceof HTMLElement) deconItemInfoTitle.hidden = false;
  if (deconItemInfoSep instanceof HTMLElement) deconItemInfoSep.hidden = false;
  checkDeconStarState();
};

const renderDeconItemLevel = () => {
  if (!(deconLevelRow instanceof HTMLElement)) return;
  const def = selectedItem ? itemLevelUpByItemId.get(selectedItem.id) : null;
  const maxLevelUps = Number.isInteger(def?.maxLevelUps) ? def.maxLevelUps : 0;
  // data-decon-level-row.hidden = !selectedItem
  deconLevelRow.hidden = !selectedItem || maxLevelUps <= 0;
  if (maxLevelUps > 0 && deconLevelMaxBtn instanceof HTMLButtonElement) {
    deconLevelMaxBtn.textContent = 'MAX';
  }
  if (deconLevelValue instanceof HTMLElement) {
    deconLevelValue.textContent = String(deconAppliedLevelCount + 1);
  }
  updateTargetCard();
  if (deconItemLevelUpSource instanceof HTMLInputElement && deconItemLevelUpSource.checked) {
    buildLevelUpSlotEditors();
  }
  equalizeGroupLabels(deconEditContent, '.decon-success-row > .chaos-stat-label, .decon-slot-row > .chaos-stat-label, .decon-level-row:not([hidden]) > .chaos-stat-label');
  updateLevelUpSourceEligibility();
  checkDeconStarState();
};

// ---- Item search handling (adapted from expected-value.astro) ----
const syncJobButtons = () => {
  jobInputs?.forEach((input) => {
    if (!(input instanceof HTMLInputElement)) return;
    input.closest('.choice-button')?.classList.toggle('active', input.checked);
  });
};

const setManualSearchOpen = (isOpen) => {
  if (!(manualSearchToggle instanceof HTMLButtonElement) || !(manualSearchFields instanceof HTMLElement)) {
    return;
  }
  manualSearchToggle.setAttribute('aria-expanded', String(isOpen));
  manualSearchFields.classList.toggle('open', isOpen);
  manualSearchFields.setAttribute('aria-hidden', String(!isOpen));
  manualSearchFields.inert = !isOpen;
  if (!isOpen) {
    if (equipmentMenu instanceof HTMLElement && equipmentTrigger instanceof HTMLButtonElement) {
      equipmentMenu.hidden = true;
      equipmentTrigger.setAttribute('aria-expanded', 'false');
      toggleEquipmentDropdownOpen(false);
    }
  }
};

const toggleEquipmentDropdownOpen = (isOpen) => {
  if (manualSearchAccordionInner instanceof HTMLElement) {
    manualSearchAccordionInner.classList.toggle('dropdown-open', isOpen);
  }
};

const syncItemSearchUrl = () => {
  if (!(itemNameInput instanceof HTMLInputElement) || !(equipmentInput instanceof HTMLInputElement)) return;
  const levelRange =
    levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement
      ? (() => {
          const min = parseInt(levelMinInput.value, 10) || 0;
          const max = parseInt(levelMaxInput.value, 10) || 200;
          return { min, max };
        })()
      : { min: 0, max: 0 };
  form?.setAttribute(
    'data-item-search-url',
    buildItemSearchUrl({
      searchFor: itemNameInput.value,
      equipmentKind: equipmentInput.value,
      requiredLevelMin: levelRange.min,
      requiredLevelMax: levelRange.max,
    }),
  );
};

const hideItemSuggestions = () => {
  if (itemSuggestions instanceof HTMLElement) {
    itemSuggestions.hidden = true;
  }
  if (itemNameInput instanceof HTMLInputElement) {
    itemNameInput.setAttribute('aria-expanded', 'false');
  }
};

const hasDeconDraftState = () => (
  selectedItem !== null &&
  (
    deconHasActionableResults ||
    (deconResultContent instanceof HTMLElement && !deconResultContent.hidden) ||
    Object.values(deconDeltas).some((value) => Number.isFinite(value) && value !== 0) ||
    deconSlotState.successfulScrollCount !== 0 ||
    deconSlotState.remainingSlots !== deconSlotState.maxSlots ||
    deconAppliedLevelCount !== 0
  )
);

const clearDeconCalculationState = (item) => {
  deconDeltas = {};
  deconStatKeys = [];
  deconHasActionableResults = false;
  deconSlotState = createDeconstructionSlotState(item?.stats?.upgradeSlots ?? 0);
  deconAppliedLevelCount = 0;
  deconScrollRateFilter = new Set(['100', '60', '10']);
  deconStimulantBoundsMap = {};
  deconChaosBoundsMap = {};
  deconGemFilter = null;
  deconGemEligible = true;
  deconLevelUpTotalRanges = {};
  deconScrollRateInputs.forEach(inp => {
    if (inp instanceof HTMLInputElement) {
      inp.checked = deconScrollRateFilter.has(inp.dataset.deconScrollRate);
    }
  });
};

const commitSuggestedItem = (item, { syncFilters = true } = {}) => {
  if (!(itemNameInput instanceof HTMLInputElement)) return;
  const itemChanged = selectedItem?.id !== item.id;
  if (itemChanged) {
    clearDeconCalculationState(item);
  }
  if (syncFilters) {
    itemNameInput.value = item.nameKo;
  }
  if (selectedItemIdInput instanceof HTMLInputElement) {
    selectedItemIdInput.value = String(item.id);
  }
  form?.setAttribute('data-selected-item-id', String(item.id));
  if (syncFilters) {
    syncFiltersToSelectedItem(item);
  }
  selectedItem = item;
  if (itemChanged) resetAllowedSources();
  updateLevelUpSourceEligibility();
  updateSourcePanelForItem(item);
  renderDeconItemLevel();
  renderTargetItemCard(item);
  activateDeconEditPanel(item);
  if (syncFilters) {
    syncItemSearchUrl();
    hideItemSuggestions();
    renderManualItemResults();
  }
};

const selectSuggestedItem = (item, { syncFilters = true } = {}) => {
  const itemChanged = selectedItem?.id !== item.id;
  if (itemChanged && hasDeconDraftState()) {
    showDeconItemChangeDialog(() => {
      commitSuggestedItem(item, { syncFilters });
    });
    return;
  }
  commitSuggestedItem(item, { syncFilters });
};

const renderItemSuggestions = () => {
  if (!(itemNameInput instanceof HTMLInputElement) || !(itemSuggestions instanceof HTMLElement)) return;
  itemSuggestions.replaceChildren();

  const results = searchKoreanItems(itemNameInput.value, { items: itemIndex });
  if (results.length === 0) {
    hideItemSuggestions();
    return;
  }

  results.forEach((item) => {
    const option = document.createElement('button');
    option.type = 'button';
    option.className = 'item-suggestion-option';
    option.setAttribute('role', 'option');
    option.dataset.itemId = String(item.id);

    const icon = document.createElement('img');
    icon.className = 'item-suggestion-icon';
    icon.src = buildItemIconUrl(item.id);
    icon.alt = '';
    icon.loading = 'lazy';

    const text = document.createElement('span');
    text.className = 'item-suggestion-text';
    const name = document.createElement('strong');
    name.textContent = item.nameKo;
    const meta = document.createElement('span');
    meta.textContent = item.equipmentKind;
    text.append(name, meta);

    option.append(icon, text);
    option.addEventListener('click', () => {
      selectSuggestedItem(item);
    });
    itemSuggestions.append(option);
  });

  itemSuggestions.hidden = false;
  itemNameInput.setAttribute('aria-expanded', 'true');
};

const setEquipmentOption = (button) => {
  if (!(equipmentInput instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) return;
  form?.querySelectorAll('[data-equipment-option]').forEach((option) => {
    const isActive = option === button;
    option.classList.toggle('active', isActive);
    option.setAttribute('aria-selected', String(isActive));
  });
  equipmentInput.value = button.dataset.equipmentOption ?? '';
  if (equipmentTriggerLabel instanceof HTMLElement) {
    equipmentTriggerLabel.textContent = equipmentInput.value;
  }
  renderManualItemResults();
  syncItemSearchUrl();
  if (equipmentMenu instanceof HTMLElement && equipmentTrigger instanceof HTMLButtonElement) {
    equipmentMenu.hidden = true;
    equipmentTrigger.setAttribute('aria-expanded', 'false');
    toggleEquipmentDropdownOpen(false);
  }
};

const syncJobsToSelectedItem = (item) => {
  const requiredJobs = item.requiredJobs ?? [];
  const selectedJobs = new Set(requiredJobs.map((job) => jobKindByRequiredJob[job]).filter(Boolean));
  const shouldSelectAll = selectedJobs.size === 0;
  jobInputs?.forEach((input) => {
    if (input instanceof HTMLInputElement) {
      input.checked = shouldSelectAll || selectedJobs.has(input.value);
    }
  });
  syncJobButtons();
};

const syncEquipmentToSelectedItem = (item) => {
  const matchingOption = [...(equipmentOptionButtons ?? [])].find(
    (option) => option instanceof HTMLButtonElement && option.dataset.equipmentOption === item.equipmentKind,
  );
  if (!(matchingOption instanceof HTMLButtonElement)) return;
  const matchingGroup = matchingOption.closest('[data-equipment-options]');
  const matchingMode = matchingGroup instanceof HTMLElement ? matchingGroup.dataset.equipmentOptions : undefined;
  equipmentOptionGroups?.forEach((group) => {
    if (group instanceof HTMLElement) {
      group.hidden = group !== matchingGroup;
    }
  });
  equipmentModeButtons?.forEach((button) => {
    if (button instanceof HTMLButtonElement) {
      button.classList.toggle('active', button.dataset.equipmentMode === matchingMode);
    }
  });
  setEquipmentOption(matchingOption);
};

const syncFiltersToSelectedItem = (item) => {
  syncJobsToSelectedItem(item);
  syncEquipmentToSelectedItem(item);
  if (levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement) {
    const requiredLevel = String(item.requiredLevel);
    levelMinInput.value = requiredLevel;
    levelMaxInput.value = requiredLevel;
  }
};

const getSelectedJobKinds = () =>
  new Set(
    [...(jobInputs ?? [])]
      .filter((input) => input instanceof HTMLInputElement && input.checked)
      .map((input) => input.value),
  );

const itemMatchesSelectedJobs = (item, selectedJobs) => {
  if (selectedJobs.size === 0) return false;
  const requiredJobs = item.requiredJobs ?? [];
  const hasOnlyBeginner = requiredJobs.length === 1 && requiredJobs[0] === 'Beginner';
  if (requiredJobs.length === 0 || hasOnlyBeginner) return true;
  return requiredJobs.some((job) => selectedJobs.has(jobKindByRequiredJob[job]));
};

const getManualFilteredItems = () => {
  if (!(equipmentInput instanceof HTMLInputElement)) return [];
  if (!equipmentInput.value) return [];
  const selectedJobs = getSelectedJobKinds();
  const levelRange =
    levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement
      ? (() => {
          const min = parseInt(levelMinInput.value, 10) || 0;
          const max = parseInt(levelMaxInput.value, 10) || 200;
          return { min, max };
        })()
      : { min: 0, max: 0 };
  return itemIndex
    .filter((item) => item.equipmentKind === equipmentInput.value)
    .filter((item) => item.requiredLevel >= levelRange.min && item.requiredLevel <= levelRange.max)
    .filter((item) => itemMatchesSelectedJobs(item, selectedJobs))
    .sort((a, b) => a.requiredLevel - b.requiredLevel || a.nameKo.localeCompare(b.nameKo, 'ko-KR'));
};

const renderManualItemResults = () => {
  if (!(manualItemResults instanceof HTMLElement)) return;
  manualItemResults.replaceChildren();

  const results = getManualFilteredItems();
  if (results.length === 0) {
    manualItemResults.hidden = true;
    return;
  }

  const MAX_RESULTS = 100;
  if (results.length > MAX_RESULTS) {
    const warning = document.createElement('div');
    warning.className = 'manual-item-overflow-warning';
    warning.textContent = '검색 결과가 너무 많습니다. 위에 필터들을 더 좁혀주세요.';
    manualItemResults.append(warning);
    manualItemResults.hidden = false;
    return;
  }

  const list = document.createElement('div');
  list.className = 'manual-item-list';
  results.forEach((item) => {
    const option = document.createElement('button');
    option.type = 'button';
    option.className = 'manual-item-option';
    option.dataset.itemId = String(item.id);
    const icon = document.createElement('img');
    icon.className = 'manual-item-icon';
    icon.src = buildItemIconUrl(item.id);
    icon.alt = '';
    icon.loading = 'lazy';
    const text = document.createElement('span');
    text.className = 'manual-item-text';
    const name = document.createElement('strong');
    name.textContent = item.nameKo;
    const meta = document.createElement('span');
    meta.textContent = item.equipmentKind;
    text.append(name, meta);
    option.append(icon, text);
    option.addEventListener('click', () => {
      selectSuggestedItem(item, { syncFilters: false });
    });
    list.append(option);
  });
  manualItemResults.append(list);
  manualItemResults.hidden = false;
};

// ---- Deconstruction panel activation ----
const activateDeconEditPanel = (item) => {
  if (
    !(deconEditPlaceholder instanceof HTMLElement) ||
    !(deconEditContent instanceof HTMLElement)
  ) {
    return;
  }

  deconEditPlaceholder.hidden = true;
  deconEditContent.hidden = false;
  if (deconItemInfoTitle instanceof HTMLElement) deconItemInfoTitle.hidden = false;
  if (deconItemInfoSep instanceof HTMLElement) deconItemInfoSep.hidden = false;
  if (deconCalcPlaceholder instanceof HTMLElement) deconCalcPlaceholder.hidden = true;
  if (deconCalcContent instanceof HTMLElement) deconCalcContent.hidden = false;
  deconHasActionableResults = false;
  if (deconResultPlaceholder instanceof HTMLElement) deconResultPlaceholder.hidden = false;
  if (deconResultContent instanceof HTMLElement) deconResultContent.hidden = true;
  renderTargetChips();

  // Reset slot history from the selected clean item
  deconSlotState = createDeconstructionSlotState(item.stats?.upgradeSlots ?? 0);
  deconAppliedLevelCount = 0;
  deconScrollRateFilter = new Set(['100', '60', '10']);
  deconStimulantBoundsMap = {};
  deconChaosBoundsMap = {};
  if (deconChaosBounds instanceof HTMLElement) {
    deconChaosBounds.classList.remove('decon-source-sub--open');
    deconChaosBounds.hidden = true;
  }
  deconGemFilter = null;
  deconLevelUpTotalRanges = {};
  deconScrollRateInputs.forEach(inp => {
    if (inp instanceof HTMLInputElement) {
      inp.checked = deconScrollRateFilter.has(inp.dataset.deconScrollRate);
    }
  });
  renderDeconSlotState();
  renderDeconItemLevel();

  // Build stat editor
  const statKeys = ['str', 'dex', 'int', 'luk', 'maxHp', 'maxMp', 'weaponAttack', 'magicAttack', 'weaponDefense', 'magicDefense', 'accuracy', 'avoidability', 'speed', 'jump'];
  deconStatKeys = statKeys.filter((k) => {
    const baseVal = item.stats?.[k];
    return Number.isFinite(baseVal) && baseVal > 0;
  });
  rebuildStatEditor();
  updateAnalyzeButton();
  renderDeconSlotBar();
  checkDeconStarState();
};

// ---- Save slot helpers ----
const buildDeconPageState = () => {
  if (!selectedItem) return null;
  // Strip zero entries — rebuildStatEditor seeds missing keys as 0,
  // which would otherwise break slot match after load
  const deltas = {};
  for (const key of deconStatKeys) {
    const value = deconDeltas[key];
    if (value !== 0 && Number.isFinite(value)) deltas[key] = value;
  }
  return {
    itemId: selectedItem.id,
    deconDeltas: deltas,
    successfulScrollCount: deconSlotState.successfulScrollCount,
    deconStatKeys: [...deconStatKeys],
    remainingSlots: deconSlotState.remainingSlots,
    appliedLevelCount: deconAppliedLevelCount,
  };
};

const checkDeconStarState = () => {
  if (!selectedItem || !(deconStar instanceof HTMLElement)) return;
  const state = buildDeconPageState();
  if (!state) {
    deconStar.textContent = '☆';
    deconStar.classList.remove('item-card-star--saved');
    console.log('checkDeconStarState: no state → ☆');
    return;
  }
  const match = findMatchingSlot('deconstruction', state);
  if (match >= 0) {
    deconStar.textContent = '★';
    deconStar.classList.add('item-card-star--saved');
    console.log('checkDeconStarState: match slot', match, '→ ★');
  } else {
    deconStar.textContent = '☆';
    deconStar.classList.remove('item-card-star--saved');
    console.log('checkDeconStarState: no match → ☆', 'state:', state);
  }
};

const renderDeconSlotBar = () => {
  if (!(deconSlotBar instanceof HTMLElement)) return;
  const slots = readSlots('deconstruction');
  deconSlotBar.replaceChildren();
  for (let i = 0; i < MAX_SLOTS; i++) {
    const s = slots[i];
    const box = document.createElement('div');
    box.className = s ? 'item-slot item-slot--filled' : 'item-slot item-slot--empty';
    if (s) {
      const icon = document.createElement('img');
      icon.src = buildItemIconUrl(s.item.iconId);
      icon.alt = s.item.nameKo;
      box.append(icon);
      box.title = s.item.nameKo;
      box.addEventListener('click', () => loadDeconSlot(i));

      const xBtn = document.createElement('button');
      xBtn.type = 'button';
      xBtn.className = 'item-slot-x';
      xBtn.textContent = '×';
      xBtn.addEventListener('click', (e) => { e.stopPropagation(); confirmDeleteDeconSlot(i); });
      box.append(xBtn);
    }
    deconSlotBar.append(box);
  }
};

const showDeconSavePicker = () => {
  if (!selectedItem) return;
  const state = buildDeconPageState();
  if (!state) return;

  const slots = readSlots('deconstruction');
  const overlay = document.createElement('div');
  overlay.className = 'slot-picker-overlay';

  const dialog = document.createElement('div');
  dialog.className = 'slot-picker-dialog';

  const title = document.createElement('h3');
  title.textContent = '저장할 슬롯 선택';
  dialog.append(title);

  const grid = document.createElement('div');
  grid.className = 'slot-picker-grid';

  for (let i = 0; i < MAX_SLOTS; i++) {
    const s = slots[i];
    const cell = document.createElement('div');
    cell.className = s ? 'slot-picker-slot slot-picker-slot--filled' : 'slot-picker-slot slot-picker-slot--empty';
    if (s) {
      const icon = document.createElement('img');
      icon.src = buildItemIconUrl(s.item.iconId);
      icon.alt = s.item.nameKo;
      cell.append(icon);
      const name = document.createElement('span');
      name.className = 'slot-picker-slot-name';
      name.textContent = s.item.nameKo;
      cell.append(name);
      cell.addEventListener('click', () => {
        overlay.remove();
        confirmReplaceDeconSlot(i, state);
      });
    } else {
      cell.textContent = '빈 슬롯';
      cell.addEventListener('click', () => {
        saveToSlot('deconstruction', i, selectedItem, state);
        overlay.remove();
        renderDeconSlotBar();
        checkDeconStarState();
      });
    }
    grid.append(cell);
  }
  dialog.append(grid);

  const closeBtn = document.createElement('button');
  closeBtn.type = 'button';
  closeBtn.className = 'slot-picker-close';
  closeBtn.textContent = '취소';
  closeBtn.addEventListener('click', () => overlay.remove());
  dialog.append(closeBtn);

  overlay.append(dialog);
  document.body.append(overlay);
};

