	  // Handle cancel: return to placeholder
	  targetUI.onCancel(() => {
	    showEvPlaceholder();
	  });

	  // Handle start: run calculation
	  targetUI.onStart(() => {
	    runEvCalculation(targetUI.getCheckedStats(), targetUI.getTrialCount(), cleanStats, previewStats, enhancementState, selectedBaseItem);
	  });
	};

	/** Run the actual EV calculation and display results. */
	const runEvCalculation = (checkedStats, trialCount, cleanStats, previewStats, enhancementState, selectedBaseItem) => {
	  // Get target conditions from the user's enhanced preview
	  const targetConditions = extractTargetConditions(cleanStats, previewStats, checkedStats, 0);

	  // Build a single strategy from the user's actual enhancement state
	  const scrollSequence = enhancementState.scrollState.slots.filter(s => s !== null);
	  const makerChoices = enhancementState.gemSlots
	    .filter(s => s !== null)
	    .map(s => (s.stats
	      ? { gemKey: s.gemKey, stats: s.stats }
	      : { gemKey: s.gemKey, grade: s.gradeIndex }));

	  // Pre-apply user-specified (non-random) stats so they don't flag the
	  // strategy as non-deterministic.  This covers stimulant + item level-up,
	  // both of which have stats the user chose directly.
	  const effectiveCleanStats = { ...cleanStats };
	  const adjustedThresholds = { ...targetConditions.statThresholds };

	  const preApply = (stats) => {
	    for (const [key, value] of Object.entries(stats ?? {})) {
	      if (!Number.isFinite(value)) continue;
	      effectiveCleanStats[key] = (effectiveCleanStats[key] ?? 0) + value;
	      if (adjustedThresholds[key] !== undefined) {
	        adjustedThresholds[key] = Math.max(0, adjustedThresholds[key] - value);
	      }
	    }
	  };

	  // Stimulant (user-chosen stats, guaranteed)
	  if (enhancementState.stimulantSlot?.stats) {
	    preApply(enhancementState.stimulantSlot.stats);
	  }

	  // Item level-up slots (user-chosen stats, guaranteed)
	  for (const slot of enhancementState.itemLevelUpSlots ?? []) {
	    if (slot?.stats) preApply(slot.stats);
	  }

	  const effectiveTargetConditions = {
	    ...targetConditions,
	    statThresholds: adjustedThresholds,
	  };

	  const userStrategy = {
	    makerChoices,
	    scrollSequence,
	    useItemLevelUp: false,
	  };

	  // Create or reuse result UI
	  if (!evResultUI) {
	    evResultUI = createResultUI();
	    if (resultContent instanceof HTMLElement) {
	      resultContent.replaceChildren();
	      resultContent.appendChild(evResultUI.container);
	    }
	  }

	  const hasEnhancements = scrollSequence.length > 0 || makerChoices.length > 0
	    || enhancementState.stimulantSlot !== null
	    || enhancementState.itemLevelUpSlots.some(s => s !== null);

	  if (isDeterministicStrategy(userStrategy)) {
	    const probability = hasEnhancements
	      ? computeExactProbability(userStrategy, effectiveCleanStats, effectiveTargetConditions)
	      : 1.0;

	    const resultSummary = createResultSummary({
	      successProbability: probability,
	      isExact: true,
	      trialCount,
	      bestStrategy: userStrategy,
	    });
	    evResultUI.update(resultSummary);
	    evResultSummary = resultSummary;
	  } else {
	    // Non-deterministic scrolls (chaos) or random gems — use Monte Carlo
	    const seed = createRandomSeed();
	    const simResult = runStrategyMonteCarloSimulation(
	      userStrategy,
	      effectiveCleanStats,
	      effectiveTargetConditions,
	      trialCount,
	      seed,
	    );

	    const resultSummary = createResultSummary({
	      successProbability: simResult.successProbability,
	      isExact: false,
	      trialCount,
	      bestStrategy: userStrategy,
	    });
	    evResultUI.update(resultSummary);
	    evResultSummary = resultSummary;
	  }
	};

	// EV calc button click handler
	evTrigger?.addEventListener('click', () => {
	  if (!(evTrigger instanceof HTMLButtonElement) || evTrigger.disabled) return;

	  if (evResultSummary) {
	    // Result already exists — show confirmation first
	    showEvConfirmationDialog(() => {
	      evResultSummary = null;
	      evResultUI = null;
	      openEvTargetSelection();
	    });
	  } else {
	    openEvTargetSelection();
	  }
	});

</script>

