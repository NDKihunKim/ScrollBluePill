---
import BaseLayout from '../layouts/BaseLayout.astro';
import { armorKinds, jobKinds, weaponKinds } from '../lib/calculatorInput.mjs';
import { MAPLESTORY_IO_REGION, MAPLESTORY_IO_VERSION } from '../lib/maplestoryIo.mjs';

---

<BaseLayout
	title="주문서 확률 계산기"
	description="MapleWorlds 옛날 메이플 주문서 확률 계산을 위한 한국어 도구입니다."
>
	<section class="band">
		<div class="container">
			<p class="eyebrow">MapleWorlds old-school scroll calculator</p>
			<h1>주문서 확률 계산기</h1>
			<p class="lede">
				고정 주문서와 랜덤 주문서 데이터를 버전별로 정리하고, 목표 스탯 도달 확률과
				기대값을 계산하기 위한 작업 공간입니다.
			</p>
		</div>
	</section>

	<section class="band">
		<div class="container grid two">
			<div class="left-stack">
			<form
				class="panel"
				aria-label="주문서 계산 입력"
				data-calculator-input
				data-maplestory-region={MAPLESTORY_IO_REGION}
				data-maplestory-version={MAPLESTORY_IO_VERSION}
			>
				<h2>1. 아이템 검색</h2>
				<div class="item-search-fields">
					<div class="input-row field-block item-name-search" data-item-name-search>
						<label class="field-label" for="item-name-input">아이템 이름</label>
						<input
							id="item-name-input"
							type="search"
							name="itemName"
							placeholder="예: 노가다 목장갑, 노목"
							autocomplete="off"
							aria-autocomplete="list"
							aria-controls="item-suggestion-list"
							aria-expanded="false"
							data-item-name-input
						/>
						<input type="hidden" name="itemId" data-selected-item-id />
						<div
							id="item-suggestion-list"
							class="item-suggestion-menu"
							role="listbox"
							aria-label="아이템 검색 결과"
							data-item-suggestions
							hidden
						>
						</div>
					</div>
						<button
							type="button"
							class="manual-search-toggle"
							aria-expanded="false"
							aria-controls="manual-search-fields"
							data-manual-search-toggle
						>
							필터 검색
						</button>
						<div
							id="manual-search-fields"
							class="manual-search-accordion"
							aria-hidden="true"
							data-manual-search-fields
							inert
						>
							<div class="manual-search-accordion-inner">
								<fieldset class="input-row job-options">
						<div class="field-header">
							<legend>직업</legend>
							<div class="compact-actions">
								<button type="button" class="small-button secondary" data-job-select-all>전체 선택</button>
								<button type="button" class="small-button secondary" data-job-clear-all>전체 해제</button>
							</div>
						</div>
						<div class="choice-row">
							{
								jobKinds.map((job) => (
									<label class="choice-button">
										<input type="checkbox" name="jobs" value={job} checked hidden />
										<span>{job}</span>
									</label>
								))
							}
						</div>
					</fieldset>
					<div class="input-row field-block equipment-block">
						<div class="field-header">
							<span id="equipment-kind-label" class="field-label">장비 종류</span>
							<div class="segmented-control" aria-label="장비 종류 범위">
								<button type="button" class="segment" data-equipment-mode="weapon">무기</button>
								<button type="button" class="segment" data-equipment-mode="armor">장비</button>
							</div>
						</div>
						<input type="hidden" name="equipmentKind" value="" data-equipment-kind />
						<div class="dropdown-frame" data-equipment-dropdown>
							<button
								type="button"
								class="dropdown-trigger"
								aria-expanded="false"
								aria-haspopup="listbox"
								aria-labelledby="equipment-kind-label"
								data-equipment-trigger
							>
								<span data-equipment-trigger-label>장비 종류를 먼저 골라주세요</span>
								<span aria-hidden="true">⌄</span>
							</button>
							<div class="equipment-menu" role="listbox" aria-labelledby="equipment-kind-label" data-equipment-menu hidden>
								<div data-equipment-options="weapon" hidden>
								{
									weaponKinds.map((kind, index) => (
										<button
											type="button"
											class='equipment-option'
											data-equipment-option={kind}
											role="option"
											aria-selected='false'
										>
											{kind}
										</button>
									))
								}
								</div>
								<div data-equipment-options="armor" hidden>
								{
									armorKinds.map((kind) => (
										<button type="button" class="equipment-option" data-equipment-option={kind} role="option" aria-selected="false">
											{kind}
										</button>
									))
								}
								</div>
							</div>
						</div>
								<div class="input-row field-block level-range-block">
									<span class="field-label">아이템 요구 레벨</span>
									<div class="level-range-control">
										<span class="level-stepper">
											<button type="button" class="step-button" data-level-bound="min" data-level-step="-5" aria-label="최소 요구 레벨 5 감소">
												-5
											</button>
											<input
												type="number"
												name="requiredLevelMin"
												value="0"
												min="0"
												step="5"
												inputmode="numeric"
												aria-label="최소 요구 레벨"
												data-level-input
												data-level-min-input
											/>
											<button type="button" class="step-button" data-level-bound="min" data-level-step="5" aria-label="최소 요구 레벨 5 증가">
												+5
											</button>
										</span>
										<span class="level-range-separator" aria-hidden="true">-</span>
										<span class="level-stepper">
											<button type="button" class="step-button" data-level-bound="max" data-level-step="-5" aria-label="최대 요구 레벨 5 감소">
												-5
											</button>
											<input
												type="number"
												name="requiredLevelMax"
												value="200"
												min="0"
												step="5"
												inputmode="numeric"
												aria-label="최대 요구 레벨"
												data-level-input
												data-level-max-input
											/>
											<button type="button" class="step-button" data-level-bound="max" data-level-step="5" aria-label="최대 요구 레벨 5 증가">
												+5
											</button>
										</span>
									</div>
								</div>
								<div class="manual-item-results" data-manual-item-results hidden></div>
							</div>
						</div>
					</div>
					</div>
			</form>

			<form class="panel" aria-label="주문서 강화" data-enhancement-panel hidden>
				<h2>2. 아이템 강화</h2>

				<div data-enhancement-dormant>
					<p class="enhancement-placeholder">먼저 위에서 아이템을 선택해주세요</p>
				</div>

				<div data-enhancement-active hidden>
					<p class="enhancement-equipment-label">선택된 장비: <strong data-enhancement-equipment-kind></strong></p>

					<div class="slot-checkpoint-row" data-slot-checkpoint-row>
					</div>

					<div class="scroll-detail-popup" data-scroll-detail-popup hidden>
						<strong data-scroll-detail-name></strong>
						<span data-scroll-detail-stat></span>
					</div>

					<button type="button" class="small-button secondary" data-enhancement-reset>
						초기화
					</button>

					<div class="enhancement-scroll-section">
						<p class="enhancement-section-label">주문서 목록</p>
						<div class="scroll-list" data-scroll-list>
						</div>
						<div class="enhancement-message" data-enhancement-message hidden></div>
					</div>
						<div class="maker-section" data-maker-section hidden>
							<div class="maker-toggle-row">
								<button type="button" class="maker-toggle-button" data-maker-toggle disabled>
									메이커
								</button>
							</div>
							<div class="maker-gem-area" data-maker-gem-area hidden>
								<p class="enhancement-section-label">추가 재료</p>
								<div class="maker-gem-slots" data-maker-gem-slots>
								</div>
								<div class="maker-picker" data-maker-picker hidden>
									<p class="enhancement-section-label" data-maker-picker-label>보석 종류 선택</p>
									<div class="maker-picker-grid" data-maker-picker-grid>
									</div>
									<button type="button" class="small-button secondary maker-picker-back" data-maker-picker-back>
										뒤로
									</button>
								</div>
							</div>
						</div>
				</div>
			</form>
			</div>

			<aside class="panel" aria-label="계산 결과">
				<h2>아이템</h2>
				<div class="selected-item-card" data-selected-item-card hidden>
					<h3 data-selected-item-name></h3>
					<div class="selected-item-top">
						<div class="selected-item-icon-frame">
							<img data-selected-item-icon alt="" />
						</div>
						<div class="selected-item-requirements" data-selected-item-requirements></div>
					</div>
					<div class="selected-item-jobs" data-selected-item-jobs></div>
					<div class="selected-item-divider"></div>
					<div class="selected-item-stats" data-selected-item-stats></div>
				</div>
			</aside>
		</div>
	</section>

	<section class="band">
		<div class="container">
			<div class="ad-slot" aria-label="광고 영역">광고 영역</div>
		</div>
	</section>

	<section class="band">
		<div class="container grid three">
			<a class="card" href="/guides/fixed-random-scrolls/">
				<h2>고정 주문서와 랜덤 주문서</h2>
				<p>주문서 유형별 데이터 프레임을 정리합니다.</p>
			</a>
			<a class="card" href="/guides/probability-outputs/">
				<h2>확률 결과 항목</h2>
				<p>분포, 기대값, 목표 확률, 백분위 출력 기준을 정리합니다.</p>
			</a>
			<a class="card" href="/guides/version-tags/">
				<h2>버전 태그</h2>
				<p>MapleWorlds 서버와 데이터 기준을 분리해 관리합니다.</p>
			</a>
		</div>
	</section>
</BaseLayout>

<script>
	import { nextItemLevel, normalizeItemLevel, normalizeItemLevelRange } from '../lib/calculatorInput.mjs';
	import { searchKoreanItems } from '../lib/itemSearch.mjs';
	import { buildItemIconUrl, buildItemSearchUrl } from '../lib/maplestoryIo.mjs';

	const form = document.querySelector('[data-calculator-input]');
	const itemNameSearch = form?.querySelector('[data-item-name-search]');
	const itemNameInput = form?.querySelector('[data-item-name-input]');
	const selectedItemIdInput = form?.querySelector('[data-selected-item-id]');
	const itemSuggestions = form?.querySelector('[data-item-suggestions]');
	const selectedItemCard = document.querySelector('[data-selected-item-card]');
	const selectedItemName = document.querySelector('[data-selected-item-name]');
	const selectedItemIcon = document.querySelector('[data-selected-item-icon]');
	const selectedItemRequirements = document.querySelector('[data-selected-item-requirements]');
	const selectedItemStats = document.querySelector('[data-selected-item-stats]');
		const selectedItemJobs = document.querySelector('[data-selected-item-jobs]');
	const levelInputs = form?.querySelectorAll('[data-level-input]');
		const levelMinInput = form?.querySelector('[data-level-min-input]');
		const levelMaxInput = form?.querySelector('[data-level-max-input]');
	const stepButtons = form?.querySelectorAll('[data-level-step]');
	const equipmentInput = form?.querySelector('[data-equipment-kind]');
	const equipmentDropdown = form?.querySelector('[data-equipment-dropdown]');
	const equipmentTrigger = form?.querySelector('[data-equipment-trigger]');
	const equipmentTriggerLabel = form?.querySelector('[data-equipment-trigger-label]');
	const equipmentMenu = form?.querySelector('[data-equipment-menu]');
	const equipmentModeButtons = form?.querySelectorAll('[data-equipment-mode]');
	const equipmentOptionGroups = form?.querySelectorAll('[data-equipment-options]');
	const equipmentOptionButtons = form?.querySelectorAll('[data-equipment-option]');
	const manualSearchToggle = form?.querySelector('[data-manual-search-toggle]');
		const manualSearchFields = form?.querySelector('[data-manual-search-fields]');
			const manualSearchAccordionInner = manualSearchFields?.querySelector('.manual-search-accordion-inner');
		const manualItemResults = form?.querySelector('[data-manual-item-results]');
		const jobInputs = form?.querySelectorAll('input[name="jobs"]');
	const jobSelectAllButton = form?.querySelector('[data-job-select-all]');
	const jobClearAllButton = form?.querySelector('[data-job-clear-all]');
	let itemIndex = [];
	let itemById = new Map();

	const syncJobButtons = () => {
		jobInputs?.forEach((input) => {
			if (!(input instanceof HTMLInputElement)) {
				return;
			}

			input.closest('.choice-button')?.classList.toggle('active', input.checked);
		});
	};

	const setManualSearchOpen = (isOpen) => {
			if (!(manualSearchToggle instanceof HTMLButtonElement) || !(manualSearchFields instanceof HTMLElement)) {
				return;
			}

			manualSearchToggle.setAttribute('aria-expanded', String(isOpen));
			manualSearchFields.classList.toggle('open', isOpen);
			manualSearchFields.setAttribute('aria-hidden', String(!isOpen));
			manualSearchFields.inert = !isOpen;

			if (!isOpen) {
				if (equipmentMenu instanceof HTMLElement && equipmentTrigger instanceof HTMLButtonElement) {
					equipmentMenu.hidden = true;
					equipmentTrigger.setAttribute("aria-expanded", "false");
					toggleEquipmentDropdownOpen(false);
				}
			}
		};

		const toggleEquipmentDropdownOpen = (isOpen) => {
			if (manualSearchAccordionInner instanceof HTMLElement) {
				manualSearchAccordionInner.classList.toggle("dropdown-open", isOpen);
			}
		};

		const syncItemSearchUrl = () => {
		if (!(itemNameInput instanceof HTMLInputElement) || !(equipmentInput instanceof HTMLInputElement)) {
			return;
		}

		const levelRange =
				levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement
					? normalizeItemLevelRange(levelMinInput.value, levelMaxInput.value)
					: normalizeItemLevelRange(0, 0);
			form?.setAttribute(
				'data-item-search-url',
				buildItemSearchUrl({
					searchFor: itemNameInput.value,
					equipmentKind: equipmentInput.value,
					requiredLevelMin: levelRange.min,
					requiredLevelMax: levelRange.max,
				}),
		);
	};

	const requirementRows = [
		['REQLEV', 'requiredLevel'],
		['REQSTR', 'str'],
		['REQDEX', 'dex'],
		['REQINT', 'int'],
		['REQLUK', 'luk'],
		['REQPOP', 'pop'],
	];
	const statRows = [
		['공격속도', 'attackSpeed'],
		['STR', 'str'],
		['DEX', 'dex'],
		['INT', 'int'],
		['LUK', 'luk'],
		['최대HP', 'maxHp'],
		['최대MP', 'maxMp'],
		['공격력', 'weaponAttack'],
		['마력', 'magicAttack'],
		['물리방어력', 'weaponDefense'],
		['마법방어력', 'magicDefense'],
		['명중률', 'accuracy'],
		['회피율', 'avoidability'],
		['이동속도', 'speed'],
		['점프력', 'jump'],
		['업그레이드 가능 횟수', 'upgradeSlots'],
	];
	const jobKindByRequiredJob = {
		Beginner: '초보자',
			Warrior: '전사',
		Magician: '마법사',
		Bowman: '궁수',
		Thief: '도적',
		Pirate: '해적',
	};

			const formatRequiredJobs = (requiredJobs = []) => {
					const allJobs = ['초보자', '전사', '마법사', '궁수', '도적', '해적'];
					const equippableSet = new Set(
						(requiredJobs ?? []).length === 0 || (requiredJobs ?? []).includes('Beginner')
							? allJobs
							: requiredJobs.map((job) => jobKindByRequiredJob[job]).filter(Boolean),
					);

					const row = document.createElement('div');
					row.className = 'selected-item-jobs-row';

					allJobs.forEach((job) => {
						const chip = document.createElement('span');
						chip.className = 'job-chip';
						chip.textContent = job;
						if (!equippableSet.has(job)) {
							chip.classList.add('job-chip--inactive');
						}
						row.append(chip);
					});

					return row;
				};

			const createItemLine = (label, value) => {
		const row = document.createElement('div');
		row.className = 'selected-item-line';

		const labelElement = document.createElement('span');
		labelElement.textContent = label;

		const valueElement = document.createElement('strong');
		valueElement.textContent = String(value);

		row.append(labelElement, document.createTextNode(' : '), valueElement);
		return row;
	};

	const weaponAttackSpeedBySubCategory = {
			'One-Handed Sword': 5,
			'Two-Handed Sword': 6,
			'One-Handed Axe': 5,
			'Two-Handed Axe': 6,
			'One-Handed Blunt Weapon': 5,
			'Two-Handed Blunt': 6,
			Spear: 7,
			'Pole Arm': 8,
			Wand: 6,
			Staff: 8,
			Bow: 6,
			Crossbow: 6,
			Claw: 4,
			Dagger: 4,
			Knuckle: 5,
			Gun: 5,
		};

		const resolveAttackSpeed = (item) => {
			if (Number.isFinite(item.stats?.attackSpeed)) {
				return item.stats.attackSpeed;
			}

			return weaponAttackSpeedBySubCategory[item.typeInfo?.subCategory] ?? null;
		};

		const formatStatValue = (key, value) => {
			if (key === 'attackSpeed') {
				const speedLabelByValue = {
					2: '매우 빠름',
					3: '빠름',
					4: '빠름',
					5: '빠름',
					6: '보통',
					7: '느림',
					8: '느림',
					9: '매우 느림',
				};
				return speedLabelByValue[value] ?? '속도 정보 없음';
			}

			if (key === 'upgradeSlots' || value <= 0) {
				return value;
			}

			return `+${value}`;
		};

	const renderSelectedItemCard = (item) => {
		if (
			!(selectedItemCard instanceof HTMLElement) ||
			!(selectedItemName instanceof HTMLElement) ||
			!(selectedItemIcon instanceof HTMLImageElement) ||
			!(selectedItemRequirements instanceof HTMLElement) ||
			!(selectedItemStats instanceof HTMLElement)
		) {
			return;
		}

		selectedItemName.textContent = item.nameKo;
		selectedItemName.style.color = '';  // reset grade color — no scrolls applied
		selectedItemIcon.src = buildItemIconUrl(item.id);
		selectedItemRequirements.replaceChildren();
		selectedItemStats.replaceChildren();
		if (selectedItemJobs instanceof HTMLElement) {
			selectedItemJobs.replaceChildren();
			selectedItemJobs.append(formatRequiredJobs(item.requiredJobs));
		}

		requirementRows.forEach(([label, key]) => {
			const value =
						key === 'requiredLevel'
							? item.requiredLevel
							: (item.requirements?.[key] ?? 0);
			selectedItemRequirements.append(createItemLine(label, value));
		});

		statRows.forEach(([label, key]) => {
			const value = key === 'attackSpeed' ? resolveAttackSpeed(item) : item.stats?.[key];
			if (Number.isFinite(value)) {
				selectedItemStats.append(createItemLine(label, formatStatValue(key, value)));
			}
		});

		selectedItemCard.hidden = false;
	};

	const clearSelectedItemCard = () => {
		if (selectedItemCard instanceof HTMLElement) {
			selectedItemCard.hidden = true;
		}
	};

	const syncJobsToSelectedItem = (item) => {
		const requiredJobs = item.requiredJobs ?? [];
		const selectedJobs = new Set(requiredJobs.map((job) => jobKindByRequiredJob[job]).filter(Boolean));
		const shouldSelectAll = selectedJobs.size === 0;

		jobInputs?.forEach((input) => {
			if (input instanceof HTMLInputElement) {
				input.checked = shouldSelectAll || selectedJobs.has(input.value);
			}
		});
		syncJobButtons();
	};

	const syncEquipmentToSelectedItem = (item) => {
		const matchingOption = [...(equipmentOptionButtons ?? [])].find(
			(option) => option instanceof HTMLButtonElement && option.dataset.equipmentOption === item.equipmentKind,
		);

		if (!(matchingOption instanceof HTMLButtonElement)) {
			return;
		}

		const matchingGroup = matchingOption.closest('[data-equipment-options]');
		const matchingMode = matchingGroup instanceof HTMLElement ? matchingGroup.dataset.equipmentOptions : undefined;

		equipmentOptionGroups?.forEach((group) => {
			if (group instanceof HTMLElement) {
				group.hidden = group !== matchingGroup;
			}
		});

		equipmentModeButtons?.forEach((button) => {
			if (button instanceof HTMLButtonElement) {
				button.classList.toggle('active', button.dataset.equipmentMode === matchingMode);
			}
		});

		setEquipmentOption(matchingOption);
	};

	const syncFiltersToSelectedItem = (item) => {
		syncJobsToSelectedItem(item);
		syncEquipmentToSelectedItem(item);

		if (levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement) {
				const requiredLevel = String(normalizeItemLevel(item.requiredLevel));
				levelMinInput.value = requiredLevel;
				levelMaxInput.value = requiredLevel;
			}
	};

	const hideItemSuggestions = () => {
		if (itemSuggestions instanceof HTMLElement) {
			itemSuggestions.hidden = true;
		}

		if (itemNameInput instanceof HTMLInputElement) {
			itemNameInput.setAttribute('aria-expanded', 'false');
		}
	};

	const selectSuggestedItem = (item, { syncFilters = true } = {}) => {
			if (!(itemNameInput instanceof HTMLInputElement)) {
				return;
			}

			if (syncFilters) {
				itemNameInput.value = item.nameKo;
			}
			if (selectedItemIdInput instanceof HTMLInputElement) {
				selectedItemIdInput.value = String(item.id);
			}
			form?.setAttribute('data-selected-item-id', String(item.id));
			if (syncFilters) {
				syncFiltersToSelectedItem(item);
			}
			renderSelectedItemCard(item);
			if (typeof window.activatePanel2 === 'function') {
				window.activatePanel2(item);
			}
			if (syncFilters) {
				syncItemSearchUrl();
				hideItemSuggestions();
				renderManualItemResults();
			}
		};

		const renderEnhancedItemCard = (item, accumulatedStats, remainingSlots, appliedCount, gradeColor) => {
		if (
			!(selectedItemCard instanceof HTMLElement) ||
			!(selectedItemName instanceof HTMLElement) ||
			!(selectedItemIcon instanceof HTMLImageElement) ||
			!(selectedItemRequirements instanceof HTMLElement) ||
			!(selectedItemStats instanceof HTMLElement)
		) {
			return;
		}

		const titleSuffix = appliedCount > 0 ? ` (+${appliedCount})` : '';
		selectedItemName.textContent = `${item.nameKo}${titleSuffix}`;
		selectedItemName.style.color = gradeColor ?? '';
		selectedItemIcon.src = buildItemIconUrl(item.id);
		selectedItemRequirements.replaceChildren();
		selectedItemStats.replaceChildren();
		if (selectedItemJobs instanceof HTMLElement) {
			selectedItemJobs.replaceChildren();
			selectedItemJobs.append(formatRequiredJobs(item.requiredJobs));
		}

		requirementRows.forEach(([label, key]) => {
			const rawValue =
				key === 'requiredLevel'
					? item.requiredLevel
					: (item.requirements?.[key] ?? 0);
			const value = key === 'pop' && rawValue === 0 ? '-' : rawValue;
			selectedItemRequirements.append(createItemLine(label, value));
		});

		statRows.forEach(([label, key]) => {
			if (key === 'upgradeSlots') {
				selectedItemStats.append(createItemLine(label, remainingSlots));
				return;
			}

			const value = key === 'attackSpeed' ? resolveAttackSpeed(item) : accumulatedStats?.[key];
			if (Number.isFinite(value)) {
				selectedItemStats.append(createItemLine(label, formatStatValue(key, value)));
			}
		});

		selectedItemCard.hidden = false;
	};

	const getSelectedJobKinds = () =>
			new Set(
				[...(jobInputs ?? [])]
					.filter((input) => input instanceof HTMLInputElement && input.checked)
					.map((input) => input.value),
			);

		const itemMatchesSelectedJobs = (item, selectedJobs) => {
			if (selectedJobs.size === 0) {
				return false;
			}

			const requiredJobs = item.requiredJobs ?? [];
			const hasOnlyBeginner = requiredJobs.length === 1 && requiredJobs[0] === 'Beginner';
			if (requiredJobs.length === 0 || hasOnlyBeginner) {
				return true;
			}

			return requiredJobs.some((job) => selectedJobs.has(jobKindByRequiredJob[job]));
		};

		const getManualFilteredItems = () => {
			if (!(equipmentInput instanceof HTMLInputElement)) {
				return [];
			}

			if (!equipmentInput.value) {
				return [];
			}

			const selectedJobs = getSelectedJobKinds();
			const levelRange =
				levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement
					? normalizeItemLevelRange(levelMinInput.value, levelMaxInput.value)
					: normalizeItemLevelRange(0, 0);

			return itemIndex
				.filter((item) => item.equipmentKind === equipmentInput.value)
				.filter((item) => item.requiredLevel >= levelRange.min && item.requiredLevel <= levelRange.max)
				.filter((item) => itemMatchesSelectedJobs(item, selectedJobs))
				.sort((a, b) => a.requiredLevel - b.requiredLevel || a.nameKo.localeCompare(b.nameKo, 'ko-KR'));
		};

		const renderManualItemResults = () => {
			if (!(manualItemResults instanceof HTMLElement)) {
				return;
			}

			manualItemResults.replaceChildren();

			const results = getManualFilteredItems();
			if (results.length === 0) {
				manualItemResults.hidden = true;
				return;
			}

			const MAX_RESULTS = 100;
			if (results.length > MAX_RESULTS) {
				const warning = document.createElement('div');
				warning.className = 'manual-item-overflow-warning';
				warning.textContent = '검색 결과가 너무 많습니다. 위에 필터들을 더 좁혀주세요.';
				manualItemResults.append(warning);
				manualItemResults.hidden = false;
				return;
			}

			const list = document.createElement('div');
			list.className = 'manual-item-list';

			results.forEach((item) => {
				const option = document.createElement('button');
				option.type = 'button';
				option.className = 'manual-item-option';
				option.dataset.itemId = String(item.id);

				const icon = document.createElement('img');
				icon.className = 'manual-item-icon';
				icon.src = buildItemIconUrl(item.id);
				icon.alt = '';
				icon.loading = 'lazy';

				const text = document.createElement('span');
				text.className = 'manual-item-text';

				const name = document.createElement('strong');
				name.textContent = item.nameKo;

				const meta = document.createElement('span');
				meta.textContent = item.equipmentKind;

				text.append(name, meta);
				option.append(icon, text);
				option.addEventListener('click', () => {
					selectSuggestedItem(item, { syncFilters: false });
				});
				list.append(option);
			});

			manualItemResults.append(list);
			manualItemResults.hidden = false;
		};

		const renderItemSuggestions = () => {
		if (!(itemNameInput instanceof HTMLInputElement) || !(itemSuggestions instanceof HTMLElement)) {
			return;
		}

		if (selectedItemIdInput instanceof HTMLInputElement) {
			selectedItemIdInput.value = '';
		}
		form?.removeAttribute('data-selected-item-id');
		clearSelectedItemCard();
		itemSuggestions.replaceChildren();

		const results = searchKoreanItems(itemNameInput.value, { items: itemIndex });
		if (results.length === 0) {
			hideItemSuggestions();
			return;
		}

		results.forEach((item) => {
			const option = document.createElement('button');
			option.type = 'button';
			option.className = 'item-suggestion-option';
			option.setAttribute('role', 'option');
			option.dataset.itemId = String(item.id);

			const icon = document.createElement('img');
			icon.className = 'item-suggestion-icon';
			icon.src = buildItemIconUrl(item.id);
			icon.alt = '';
			icon.loading = 'lazy';

			const text = document.createElement('span');
			text.className = 'item-suggestion-text';

			const name = document.createElement('strong');
			name.textContent = item.nameKo;

			const meta = document.createElement('span');
			meta.textContent = item.equipmentKind;

			text.append(name, meta);
			option.append(icon, text);
			option.addEventListener('click', () => {
				selectSuggestedItem(item);
			});
			itemSuggestions.append(option);
		});

		itemSuggestions.hidden = false;
		itemNameInput.setAttribute('aria-expanded', 'true');
	};

	const setEquipmentOption = (button) => {
		if (!(equipmentInput instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) {
			return;
		}

		form?.querySelectorAll('[data-equipment-option]').forEach((option) => {
			const isActive = option === button;
			option.classList.toggle('active', isActive);
			option.setAttribute('aria-selected', String(isActive));
		});

		equipmentInput.value = button.dataset.equipmentOption ?? '';
		if (equipmentTriggerLabel instanceof HTMLElement) {
			equipmentTriggerLabel.textContent = equipmentInput.value;
		}
			renderManualItemResults();
			syncItemSearchUrl();
		if (equipmentMenu instanceof HTMLElement && equipmentTrigger instanceof HTMLButtonElement) {
			equipmentMenu.hidden = true;
			equipmentTrigger.setAttribute('aria-expanded', 'false');
			toggleEquipmentDropdownOpen(false);
		}
	};

	levelInputs?.forEach((input) => {
			if (!(input instanceof HTMLInputElement)) {
				return;
			}

			input.addEventListener('input', () => {
				syncItemSearchUrl();
				renderManualItemResults();
			});

			input.addEventListener('blur', () => {
				input.value = String(normalizeItemLevel(input.value));
				syncItemSearchUrl();
				renderManualItemResults();
			});
		});

		stepButtons?.forEach((button) => {
			button.addEventListener('click', () => {
				if (!(button instanceof HTMLButtonElement)) {
					return;
				}

				const targetInput =
					button.dataset.levelBound === 'max'
						? levelMaxInput
						: levelMinInput;
				if (!(targetInput instanceof HTMLInputElement)) {
					return;
				}

				const delta = Number.parseInt(button.dataset.levelStep ?? '0', 10);
				targetInput.value = String(nextItemLevel(targetInput.value, delta));
				syncItemSearchUrl();
				renderManualItemResults();
			});
		});

	itemNameInput?.addEventListener('input', () => {
		syncItemSearchUrl();
		renderItemSuggestions();
	});

	manualSearchToggle?.addEventListener('click', () => {
			if (!(manualSearchToggle instanceof HTMLButtonElement)) {
				return;
			}

			setManualSearchOpen(manualSearchToggle.getAttribute('aria-expanded') !== 'true');
		});

		itemNameInput?.addEventListener('keydown', (event) => {
		if (event instanceof KeyboardEvent && event.key === 'Escape') {
			hideItemSuggestions();
		}
	});

		equipmentTrigger?.addEventListener("keydown", (event) => {
			if (event instanceof KeyboardEvent && event.key === "Escape") {
				if (equipmentMenu instanceof HTMLElement && equipmentTrigger instanceof HTMLButtonElement) {
					equipmentMenu.hidden = true;
					equipmentTrigger.setAttribute("aria-expanded", "false");
					toggleEquipmentDropdownOpen(false);
				}
			}
		});

	if (equipmentInput instanceof HTMLInputElement) {
		equipmentTrigger?.addEventListener('click', () => {
			if (!(equipmentMenu instanceof HTMLElement) || !(equipmentTrigger instanceof HTMLButtonElement)) {
				return;
			}

			// Don't open the menu until a mode (무기/장비) is selected
			const activeMode = form?.querySelector('.segment.active');
			if (!activeMode) {
				return;
			}

			const willOpen = equipmentMenu.hidden;
			equipmentMenu.hidden = !willOpen;
			equipmentTrigger.setAttribute('aria-expanded', String(willOpen));
				toggleEquipmentDropdownOpen(willOpen);
		});

		equipmentModeButtons?.forEach((button) => {
			button.addEventListener('click', () => {
				if (!(button instanceof HTMLButtonElement)) {
					return;
				}

				const mode = button.dataset.equipmentMode;
				const matchingGroup = form?.querySelector(`[data-equipment-options="${mode}"]`);

				equipmentOptionGroups?.forEach((group) => {
					if (group instanceof HTMLElement) {
						group.hidden = group !== matchingGroup;
					}
				});

				equipmentModeButtons.forEach((modeButton) => {
					modeButton.classList.toggle('active', modeButton === button);
				});

				const selectedOption =
					matchingGroup?.querySelector('.equipment-option.active') ??
					matchingGroup?.querySelector('[data-equipment-option]');
				if (selectedOption instanceof HTMLButtonElement) {
					setEquipmentOption(selectedOption);
						renderManualItemResults();
					}
			});
		});
	}

	equipmentOptionButtons?.forEach((button) => {
		button.addEventListener('click', () => {
			setEquipmentOption(button);
		});
	});

	document.addEventListener('click', (event) => {
		if (
			equipmentDropdown instanceof HTMLElement &&
			equipmentMenu instanceof HTMLElement &&
			equipmentTrigger instanceof HTMLButtonElement &&
			event.target instanceof Node &&
			!equipmentDropdown.contains(event.target)
		) {
			equipmentMenu.hidden = true;
			equipmentTrigger.setAttribute('aria-expanded', 'false');
		}

		if (
			itemNameSearch instanceof HTMLElement &&
			itemSuggestions instanceof HTMLElement &&
			itemNameInput instanceof HTMLInputElement &&
			event.target instanceof Node &&
			!itemNameSearch.contains(event.target)
		) {
			hideItemSuggestions();
		}
	});

	jobInputs?.forEach((input) => {
		input.addEventListener('change', () => {
				syncJobButtons();
				renderManualItemResults();
			});
	});

	jobSelectAllButton?.addEventListener('click', () => {
		jobInputs?.forEach((input) => {
			if (input instanceof HTMLInputElement) {
				input.checked = true;
			}
		});
		syncJobButtons();
		renderManualItemResults();
	});

	jobClearAllButton?.addEventListener('click', () => {
		jobInputs?.forEach((input) => {
			if (input instanceof HTMLInputElement) {
				input.checked = false;
			}
		});
		syncJobButtons();
		renderManualItemResults();
	});

	setManualSearchOpen(false);
	syncJobButtons();
	syncItemSearchUrl();

	fetch('/data/items-gms83-ko.json')
		.then((response) => {
			if (!response.ok) {
				throw new Error(`Unable to load item index: ${response.status}`);
			}

			return response.json();
		})
		.then((items) => {
			itemIndex = Array.isArray(items) ? items : [];
			// Zero-stat items are cosmetic cash items — hide them from search.
			itemIndex = itemIndex.filter(
				(item) => Object.keys(item.stats ?? {}).length > 0,
			);
			itemById = new Map(itemIndex.map((item) => [item.id, item]));

			const initialSelectedItemId =
				selectedItemIdInput instanceof HTMLInputElement ? Number.parseInt(selectedItemIdInput.value, 10) : NaN;
			if (itemById.has(initialSelectedItemId)) {
				renderSelectedItemCard(itemById.get(initialSelectedItemId));
			}

			renderItemSuggestions();
		})
		.catch((error) => {
			console.error(error);
		});

	import { initEnhancementPanel } from '../lib/enhancementPanel.mjs';

	window.activatePanel2 = initEnhancementPanel(renderEnhancedItemCard);
</script>

