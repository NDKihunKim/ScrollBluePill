	const evTrigger = document.querySelector('[data-ev-calc-trigger]');
	const resultPanel = document.querySelector('[data-result-panel]');
	const resultPlaceholder = resultPanel?.querySelector('[data-result-placeholder]');
	const resultContent = resultPanel?.querySelector('[data-result-content]');

	let evResultUI = null;
	let evResultSummary = null;

	/** Update EV button enabled/disabled state based on current enhancement state. */
	const updateEvButtonState = () => {
	  const evState = window.__evState?.();
	  if (!evTrigger || !(evTrigger instanceof HTMLButtonElement)) return;

	  if (!evState || !evState.enhancementState || !evState.selectedBaseItem) {
	    evTrigger.disabled = true;
	    return;
	  }

	  const st = evState.enhancementState;
	  const hasScroll = st.scrollState.slots.some(s => s !== null);
	  const hasGem = st.gemSlots.some(s => s !== null);
	  const hasStimulant = st.stimulantSlot !== null;
	  const hasLevelUp = st.itemLevelUpSlots.some(s => s !== null);
	  evTrigger.disabled = !(hasScroll || hasGem || hasStimulant || hasLevelUp);
	};

	// Register callback for enhancement state changes
	window.__evRefresh = () => {
	  updateEvButtonState();
	  if (evResultSummary && evResultUI) {
	    evResultUI.showStale();
	  }
	};

	// Initial button state
	updateEvButtonState();

	/** Show the placeholder state (initial / after cancel). */
	const showEvPlaceholder = () => {
	  if (resultPlaceholder instanceof HTMLElement && resultContent instanceof HTMLElement) {
	    resultPlaceholder.hidden = false;
	    resultContent.hidden = true;
	    resultContent.replaceChildren();
	  }
	  evResultUI = null;
	  evResultSummary = null;
	};
		// Exposed for enhancementPanel reset — fully clears EV results
		window.__evClear = showEvPlaceholder;

	/** Show a confirmation dialog overlay. Calls onConfirm if user confirms. */
	const showEvConfirmationDialog = (onConfirm) => {
	  const overlay = document.createElement('div');
	  overlay.className = 'ev-confirm-overlay';

	  const dialog = document.createElement('div');
	  dialog.className = 'ev-confirm-dialog';

	  const msg = document.createElement('p');
	  msg.textContent = CONFIRM_TEXT;

	  const buttonRow = document.createElement('div');
	  buttonRow.className = 'ev-confirm-buttons';

	  const confirmBtn = document.createElement('button');
	  confirmBtn.textContent = CONFIRM_BUTTON_TEXT;
	  confirmBtn.addEventListener('click', () => {
	    overlay.remove();
	    onConfirm();
	  });

	  const cancelBtn = document.createElement('button');
	  cancelBtn.textContent = CANCEL_BUTTON_TEXT;
	  cancelBtn.addEventListener('click', () => {
	    overlay.remove();
	  });

	  buttonRow.append(confirmBtn, cancelBtn);
	  dialog.append(msg, buttonRow);
	  overlay.append(dialog);
	  document.body.append(overlay);
	};

	/** Open the target selection UI. */
	const openEvTargetSelection = () => {
	  const evState = window.__evState?.();
	  if (!evState || !evState.enhancementState || !evState.selectedBaseItem) return;

	  const { selectedBaseItem, enhancementState } = evState;
	  const cleanStats = selectedBaseItem.stats ?? {};
	  const previewStats = computeAccumulatedStats(cleanStats, enhancementState);
	  const gains = computeEnhancementGains(cleanStats, previewStats);

	  // Create target selection UI
	  const targetUI = createTargetSelectionUI(cleanStats, previewStats, 0, gains);

	  // Replace result content
	  if (resultContent instanceof HTMLElement && resultPlaceholder instanceof HTMLElement) {
	    resultPlaceholder.hidden = true;
	    resultContent.hidden = false;
            resultContent.style.display = '';
	    resultContent.replaceChildren();
	    resultContent.appendChild(targetUI.container);
            resultPanel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
