			const breakdown = statBreakdown?.[key];
			const value = key === 'attackSpeed' ? resolveAttackSpeed(item) : (breakdown?.total ?? accumulatedStats?.[key]);
			// Hide stats that dropped to 0 or below (e.g. from negative chaos scrolls).
			// attackSpeed and upgradeSlots are metadata, not chaos-modifiable stats.
			if (Number.isFinite(value) && (key === 'attackSpeed' || key === 'upgradeSlots' || value > 0)) {
				const displayValue =
					key === 'attackSpeed'
						? formatStatValue(key, value)
						: formatStatBreakdownValue(key, breakdown ?? {
							original: item.stats?.[key] ?? 0,
							maker: 0,
							scroll: value - (item.stats?.[key] ?? 0),
							total: value,
						});
				selectedItemStats.append(createItemLine(label, displayValue));
			}
		});

		if (itemPlaceholder instanceof HTMLElement) {
			itemPlaceholder.hidden = true;
		}
		selectedItemCard.hidden = false;
		if (evStar instanceof HTMLElement) evStar.hidden = false;
		if (evCardWrapper instanceof HTMLElement) evCardWrapper.hidden = false;
	};

	const getSelectedJobKinds = () =>
			new Set(
				[...(jobInputs ?? [])]
					.filter((input) => input instanceof HTMLInputElement && input.checked)
					.map((input) => input.value),
			);

		const itemMatchesSelectedJobs = (item, selectedJobs) => {
			if (selectedJobs.size === 0) {
				return false;
			}

			const requiredJobs = item.requiredJobs ?? [];
			const hasOnlyBeginner = requiredJobs.length === 1 && requiredJobs[0] === 'Beginner';
			if (requiredJobs.length === 0 || hasOnlyBeginner) {
				return true;
			}

			return requiredJobs.some((job) => selectedJobs.has(jobKindByRequiredJob[job]));
		};

		const getManualFilteredItems = () => {
			if (!(equipmentInput instanceof HTMLInputElement)) {
				return [];
			}

			if (!equipmentInput.value) {
				return [];
			}

			const selectedJobs = getSelectedJobKinds();
			const levelRange =
				levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement
					? normalizeItemLevelRange(levelMinInput.value, levelMaxInput.value)
					: normalizeItemLevelRange(0, 0);

			return itemIndex
				.filter((item) => item.equipmentKind === equipmentInput.value)
				.filter((item) => item.requiredLevel >= levelRange.min && item.requiredLevel <= levelRange.max)
				.filter((item) => itemMatchesSelectedJobs(item, selectedJobs))
				.sort((a, b) => a.requiredLevel - b.requiredLevel || a.nameKo.localeCompare(b.nameKo, 'ko-KR'));
		};

		const renderManualItemResults = () => {
			if (!(manualItemResults instanceof HTMLElement)) {
				return;
			}

			manualItemResults.replaceChildren();

			const results = getManualFilteredItems();
			if (results.length === 0) {
				manualItemResults.hidden = true;
				return;
			}

			const MAX_RESULTS = 100;
			if (results.length > MAX_RESULTS) {
				const warning = document.createElement('div');
				warning.className = 'manual-item-overflow-warning';
				warning.textContent = '검색 결과가 너무 많습니다. 위에 필터들을 더 좁혀주세요.';
				manualItemResults.append(warning);
				manualItemResults.hidden = false;
				return;
			}

			const list = document.createElement('div');
			list.className = 'manual-item-list';

			results.forEach((item) => {
				const option = document.createElement('button');
				option.type = 'button';
				option.className = 'manual-item-option';
				option.dataset.itemId = String(item.id);

				const icon = document.createElement('img');
				icon.className = 'manual-item-icon';
				icon.src = buildItemIconUrl(item.id);
				icon.alt = '';
				icon.loading = 'lazy';

				const text = document.createElement('span');
				text.className = 'manual-item-text';

				const name = document.createElement('strong');
				name.textContent = item.nameKo;

				const meta = document.createElement('span');
				meta.textContent = item.equipmentKind;

				text.append(name, meta);
				option.append(icon, text);
				option.addEventListener('click', () => {
					selectSuggestedItem(item, { syncFilters: false });
				});
				list.append(option);
			});

			manualItemResults.append(list);
			manualItemResults.hidden = false;
		};

		const renderItemSuggestions = () => {
		if (!(itemNameInput instanceof HTMLInputElement) || !(itemSuggestions instanceof HTMLElement)) {
			return;
		}

		if (selectedItemIdInput instanceof HTMLInputElement) {
			selectedItemIdInput.value = '';
		}
		form?.removeAttribute('data-selected-item-id');
		clearSelectedItemCard();
		itemSuggestions.replaceChildren();

		const results = searchKoreanItems(itemNameInput.value, { items: itemIndex });
		if (results.length === 0) {
			hideItemSuggestions();
			return;
		}

		results.forEach((item) => {
			const option = document.createElement('button');
			option.type = 'button';
			option.className = 'item-suggestion-option';
			option.setAttribute('role', 'option');
			option.dataset.itemId = String(item.id);

			const icon = document.createElement('img');
			icon.className = 'item-suggestion-icon';
			icon.src = buildItemIconUrl(item.id);
			icon.alt = '';
			icon.loading = 'lazy';

			const text = document.createElement('span');
			text.className = 'item-suggestion-text';

			const name = document.createElement('strong');
			name.textContent = item.nameKo;

			const meta = document.createElement('span');
			meta.textContent = item.equipmentKind;

			text.append(name, meta);
			option.append(icon, text);
			option.addEventListener('click', () => {
				selectSuggestedItem(item);
			});
			itemSuggestions.append(option);
		});

		itemSuggestions.hidden = false;
		itemNameInput.setAttribute('aria-expanded', 'true');
	};

	const setEquipmentOption = (button) => {
		if (!(equipmentInput instanceof HTMLInputElement) || !(button instanceof HTMLButtonElement)) {
			return;
		}

		form?.querySelectorAll('[data-equipment-option]').forEach((option) => {
			const isActive = option === button;
			option.classList.toggle('active', isActive);
			option.setAttribute('aria-selected', String(isActive));
		});

		equipmentInput.value = button.dataset.equipmentOption ?? '';
		if (equipmentTriggerLabel instanceof HTMLElement) {
			equipmentTriggerLabel.textContent = equipmentInput.value;
		}
			renderManualItemResults();
			syncItemSearchUrl();
		if (equipmentMenu instanceof HTMLElement && equipmentTrigger instanceof HTMLButtonElement) {
			equipmentMenu.hidden = true;
			equipmentTrigger.setAttribute('aria-expanded', 'false');
