	    resultContent.hidden = true;
	    resultContent.replaceChildren();
	  }
	  evResultUI = null;
	  evResultSummary = null;
	  checkEvStarState();
	};
		// Exposed for enhancementPanel reset — fully clears EV results
		window.__evClear = showEvPlaceholder;

	/** Show a confirmation dialog overlay. Calls onConfirm if user confirms. */
	const showEvConfirmationDialog = (onConfirm, { message = CONFIRM_TEXT, confirmLabel = CONFIRM_BUTTON_TEXT } = {}) => {
	  const overlay = document.createElement('div');
	  overlay.className = 'ev-confirm-overlay';

	  const dialog = document.createElement('div');
	  dialog.className = 'ev-confirm-dialog';

	  const msg = document.createElement('p');
	  msg.textContent = message;

	  const buttonRow = document.createElement('div');
	  buttonRow.className = 'ev-confirm-buttons';

	  const confirmBtn = document.createElement('button');
	  confirmBtn.textContent = confirmLabel;
	  confirmBtn.addEventListener('click', () => {
	    overlay.remove();
	    onConfirm();
	  });

	  const cancelBtn = document.createElement('button');
	  cancelBtn.textContent = CANCEL_BUTTON_TEXT;
	  cancelBtn.addEventListener('click', () => {
	    overlay.remove();
	  });

	  buttonRow.append(confirmBtn, cancelBtn);
	  dialog.append(msg, buttonRow);
	  overlay.append(dialog);
	  document.body.append(overlay);
	};

	window.__evGuardEnhancementMutation = createResultMutationGuard({
	  hasResult: () => evResultUI !== null,
	  clearResult: showEvPlaceholder,
	  requestConfirmation: (onConfirm) => showEvConfirmationDialog(onConfirm, {
	    message: '계산 결과가 초기화됩니다. 계속하시겠습니까?',
	    confirmLabel: '계속',
	  }),
	});

	/** Render target selection UI into the calc panel. */
		const openCalcPanel = () => {
	  const evState = window.__evState?.();
	  if (!evState || !evState.enhancementState || !evState.selectedBaseItem) return;

	  const { selectedBaseItem, enhancementState, currentGradeColor } = evState;
	  const cleanStats = selectedBaseItem.stats ?? {};
	  const previewStats = computeAccumulatedStats(cleanStats, enhancementState);
	  const gains = computeEnhancementGains(cleanStats, previewStats);

	  // Create target selection UI
	  const targetUI = createTargetSelectionUI(cleanStats, previewStats, 0, gains, { preselected: evCheckedStats, gradeColor: currentGradeColor });

	  // Render into calc panel
		  if (calcContent instanceof HTMLElement && calcPlaceholder instanceof HTMLElement) {
		    calcPlaceholder.hidden = true;
		    calcContent.hidden = false;
		    calcContent.replaceChildren();
		    calcContent.appendChild(targetUI.container);
		  }

		  // Keep a reference for state preservation across re-renders
		  currentGetCheckedStats = () => targetUI.getCheckedStats();

		  // Update button state immediately
		  updateEvButtonState();

	  // Handle start: run calculation
	  targetUI.onStart(() => {
	    evCheckedStats = targetUI.getCheckedStats();
	    runEvCalculation(targetUI.getCheckedStats(), targetUI.getTrialCount(), cleanStats, previewStats, enhancementState, selectedBaseItem);
	  });
	};

		// Exposed so enhancementPanel reset can re-render target selection
		window.__evOpenCalcPanel = openCalcPanel;

	/** Run the actual EV calculation and display results. */
	const runEvCalculation = (checkedStats, trialCount, cleanStats, previewStats, enhancementState, selectedBaseItem) => {
	  // Get target conditions from the user's enhanced preview
	  const targetConditions = extractTargetConditions(cleanStats, previewStats, checkedStats, 0);

	  // Build a single strategy from the user's actual enhancement state
	  const scrollSequence = enhancementState.scrollState.slots.filter(s => s !== null);
	  const makerChoices = enhancementState.gemSlots
	    .filter(s => s !== null)
	    .map(s => (s.stats
	      ? { gemKey: s.gemKey, stats: s.stats, mode: s.mode === MATERIAL_MODE_PROBABILITY ? MATERIAL_MODE_PROBABILITY : 'manual', grade: s.gradeIndex ?? 0 }
	      : { gemKey: s.gemKey, grade: s.gradeIndex }));

	  // Pre-apply user-specified stats that are not represented in makerChoices.
	  const effectiveCleanStats = { ...cleanStats };
	  const adjustedThresholds = { ...targetConditions.statThresholds };

	  const preApply = (stats) => {
	    for (const [key, value] of Object.entries(stats ?? {})) {
	      if (!Number.isFinite(value)) continue;
	      effectiveCleanStats[key] = (effectiveCleanStats[key] ?? 0) + value;
	      if (adjustedThresholds[key] !== undefined) {
	        adjustedThresholds[key] = Math.max(0, adjustedThresholds[key] - value);
	      }
	    }
	  };

	  if (enhancementState.stimulantSlot?.stats &&
	      enhancementState.stimulantSlot.mode !== MATERIAL_MODE_PROBABILITY) {
	    preApply(enhancementState.stimulantSlot.stats);
	  }

	  // Item level-up: pre-apply only if manual mode
	  const itemLevelUpMode = enhancementState.itemLevelUpMode ?? 'manual';
	  if (itemLevelUpMode !== MATERIAL_MODE_PROBABILITY) {
	    for (const slot of enhancementState.itemLevelUpSlots ?? []) {
	      if (slot?.stats) preApply(slot.stats);
	    }
	  }

	  const effectiveTargetConditions = {
	    ...targetConditions,
	    statThresholds: adjustedThresholds,
	  };

	  const userStrategy = {
	    makerChoices,
	    scrollSequence,
	    useItemLevelUp: itemLevelUpMode === MATERIAL_MODE_PROBABILITY,
	    useStimulant: enhancementState.stimulantSlot?.mode === MATERIAL_MODE_PROBABILITY,
	  };

	  // Show result panel and hide its placeholder
	  if (resultPlaceholder instanceof HTMLElement && resultContent instanceof HTMLElement) {
	    resultPlaceholder.hidden = true;
	    resultContent.hidden = false;
	  }

	  // Create or reuse result UI
	  if (!evResultUI) {
	    evResultUI = createResultUI();
	    if (resultContent instanceof HTMLElement) {
	      resultContent.replaceChildren();
	      resultContent.appendChild(evResultUI.container);
	    }
	  }

	  const hasEnhancements = scrollSequence.length > 0 || makerChoices.length > 0
	    || enhancementState.stimulantSlot !== null
	    || enhancementState.itemLevelUpSlots.some(s => s !== null);

	  if (isDeterministicStrategy(userStrategy)) {
	    const probability = hasEnhancements
	      ? computeExactProbability(userStrategy, effectiveCleanStats, effectiveTargetConditions)
	      : 1.0;

	    if (probability <= 0) {
	      evResultUI.showZeroSuccess(/* exact → no trial count */ 0);
	      evResultSummary = null;
	    } else {
	      const resultSummary = createResultSummary({
	        successProbability: probability,
	        isExact: true,
	        trialCount,
	        bestStrategy: userStrategy,
	      });
	      evResultUI.update(resultSummary);
	      evResultSummary = resultSummary;
	    }
	  } else {
	    // Non-deterministic scrolls (chaos) or random gems — use Monte Carlo
	    const seed = createRandomSeed();
	    const simResult = runStrategyMonteCarloSimulation(
	      userStrategy,
	      effectiveCleanStats,
	      effectiveTargetConditions,
	      trialCount,
	      seed,
	    );

	    if (simResult.isZeroSuccess) {
	      evResultUI.showZeroSuccess(trialCount);
	      evResultSummary = null;
	    } else {
	      const resultSummary = createResultSummary({
	        successProbability: simResult.successProbability,
	        isExact: false,
	        trialCount,
	        bestStrategy: userStrategy,
	      });
	      evResultUI.update(resultSummary);
	      evResultSummary = resultSummary;
	    }
	  }
	};

	// Calculation is triggered from the 계산 시작 button inside the calc panel.
		// The button is rendered by createTargetSelectionUI and wired via onStart in openCalcPanel.

	// ---- Save slot helpers (EV-specific) ----
	const buildEvPageState = () => {
	  const evState = window.__evState?.();
	  if (!evState?.selectedBaseItem) return null;
	  return {
	    itemId: evState.selectedBaseItem.id,
	    enhancementState: evState.enhancementState,
	  };
	};

	const checkEvStarState = () => {
	  if (!(evStar instanceof HTMLElement)) return;
	  const state = buildEvPageState();
	  if (!state) {
	    evStar.textContent = '☆';
	    evStar.classList.remove('item-card-star--saved');
	    return;
	  }
	  const match = findMatchingSlot('expectedValue', state);
	  if (match >= 0) {
	    evStar.textContent = '★';
	    evStar.classList.add('item-card-star--saved');
	  } else {
	    evStar.textContent = '☆';
	    evStar.classList.remove('item-card-star--saved');
	  }
	};

	const renderEvSlotBar = () => {
	  if (!(evSlotBar instanceof HTMLElement)) return;
	  const slots = readSlots('expectedValue');
	  evSlotBar.replaceChildren();
	  for (let i = 0; i < MAX_SLOTS; i++) {
	    const s = slots[i];
	    const box = document.createElement('div');
	    box.className = s ? 'item-slot item-slot--filled' : 'item-slot item-slot--empty';
	    if (s) {
	      const icon = document.createElement('img');
	      icon.src = buildItemIconUrl(s.item.iconId);
	      icon.alt = s.item.nameKo;
	      box.append(icon);
	      box.title = s.item.nameKo;
	      box.addEventListener('click', () => loadEvSlot(i));

	      const xBtn = document.createElement('button');
	      xBtn.type = 'button';
	      xBtn.className = 'item-slot-x';
	      xBtn.textContent = '×';
	      xBtn.addEventListener('click', (e) => { e.stopPropagation(); confirmDeleteEvSlot(i); });
	      box.append(xBtn);
	    }
	    evSlotBar.append(box);
	  }
	};

	renderEvSlotBar();

	const showEvSavePicker = () => {
	  const evState = window.__evState?.();
	  const selectedItem = evState?.selectedBaseItem;
	  if (!selectedItem) return;
	  const state = buildEvPageState();
	  if (!state) return;

	  const slots = readSlots('expectedValue');
	  const overlay = document.createElement('div');
	  overlay.className = 'slot-picker-overlay';

	  const dialog = document.createElement('div');
	  dialog.className = 'slot-picker-dialog';

	  const title = document.createElement('h3');
	  title.textContent = '저장할 슬롯 선택';
	  dialog.append(title);

	  const grid = document.createElement('div');
	  grid.className = 'slot-picker-grid';

	  for (let i = 0; i < MAX_SLOTS; i++) {
	    const s = slots[i];
	    const cell = document.createElement('div');
	    cell.className = s ? 'slot-picker-slot slot-picker-slot--filled' : 'slot-picker-slot slot-picker-slot--empty';
	    if (s) {
	      const icon = document.createElement('img');
	      icon.src = buildItemIconUrl(s.item.iconId);
	      icon.alt = s.item.nameKo;
	      cell.append(icon);
	      const name = document.createElement('span');
	      name.className = 'slot-picker-slot-name';
	      name.textContent = s.item.nameKo;
	      cell.append(name);
	      cell.addEventListener('click', () => {
	        overlay.remove();
	        confirmReplaceEvSlot(i, state);
	      });
	    } else {
	      cell.textContent = '빈 슬롯';
	      cell.addEventListener('click', () => {
	        saveToSlot('expectedValue', i, selectedItem, state);
	        overlay.remove();
	        renderEvSlotBar();
	        checkEvStarState();
	      });
	    }
	    grid.append(cell);
	  }
	  dialog.append(grid);

	  const closeBtn = document.createElement('button');
	  closeBtn.type = 'button';
	  closeBtn.className = 'slot-picker-close';
	  closeBtn.textContent = '취소';
	  closeBtn.addEventListener('click', () => overlay.remove());
	  dialog.append(closeBtn);

	  overlay.append(dialog);
	  document.body.append(overlay);
	};

	const confirmReplaceEvSlot = (slotIndex, newState) => {
	  const evState = window.__evState?.();
	  const selectedItem = evState?.selectedBaseItem;
	  if (!selectedItem) return;

	  const slots = readSlots('expectedValue');
	  const existing = slots[slotIndex];
	  if (!existing) return;

	  const overlay = document.createElement('div');
	  overlay.className = 'slot-picker-overlay';
	  const dialog = document.createElement('div');
	  dialog.className = 'slot-picker-dialog';
	  dialog.style.maxWidth = '500px';

	  const msg = document.createElement('p');
	  msg.textContent = '기존 저장된 아이템을 덮어쓰시겠습니까?';
	  dialog.append(msg);

	  const cards = document.createElement('div');
	  cards.className = 'replace-confirm-cards';

	  const existingCard = document.createElement('div');
	  existingCard.className = 'replace-confirm-card';
	  existingCard.innerHTML = '<h4>기존 저장</h4><img src="' + buildItemIconUrl(existing.item.iconId) + '" alt=""><div class="item-name">' + existing.item.nameKo + '</div>';
	  cards.append(existingCard);

	  const newCard = document.createElement('div');
	  newCard.className = 'replace-confirm-card';
	  newCard.innerHTML = '<h4>새로 저장</h4><img src="' + buildItemIconUrl(selectedItem.id) + '" alt=""><div class="item-name">' + selectedItem.nameKo + '</div>';
	  cards.append(newCard);
	  dialog.append(cards);

	  const buttons = document.createElement('div');
	  buttons.className = 'replace-confirm-buttons';
	  const confirmBtn = document.createElement('button');
	  confirmBtn.textContent = '덮어쓰기';
	  confirmBtn.addEventListener('click', () => {
	    saveToSlot('expectedValue', slotIndex, selectedItem, newState);
	    overlay.remove();
	    renderEvSlotBar();
	    checkEvStarState();
	  });
	  const cancelBtn = document.createElement('button');
	  cancelBtn.textContent = '취소';
	  cancelBtn.addEventListener('click', () => overlay.remove());
	  buttons.append(confirmBtn, cancelBtn);
	  dialog.append(buttons);
	  overlay.append(dialog);
	  document.body.append(overlay);
	};

	const confirmDeleteEvSlot = (slotIndex) => {
	  const slots = readSlots('expectedValue');
	  const s = slots[slotIndex];
	  if (!s) return;

	  const overlay = document.createElement('div');
	  overlay.className = 'slot-picker-overlay';
	  const dialog = document.createElement('div');
	  dialog.className = 'slot-picker-dialog';

	  const msg = document.createElement('p');
	  msg.textContent = '저장된 아이템을 삭제하시겠습니까?';
	  dialog.append(msg);

	  const card = document.createElement('div');
	  card.className = 'replace-confirm-card';
	  card.innerHTML = '<img src="' + buildItemIconUrl(s.item.iconId) + '" alt=""><div class="item-name">' + s.item.nameKo + '</div>';
	  dialog.append(card);

	  const buttons = document.createElement('div');
	  buttons.className = 'replace-confirm-buttons';
	  const confirmBtn = document.createElement('button');
	  confirmBtn.textContent = '삭제';
	  confirmBtn.style.background = '#e74c3c';
	  confirmBtn.style.borderColor = '#e74c3c';
	  confirmBtn.style.color = '#fff';
	  confirmBtn.addEventListener('click', () => {
	    clearSlot('expectedValue', slotIndex);
	    overlay.remove();
	    renderEvSlotBar();
	    checkEvStarState();
	  });
	  const cancelBtn = document.createElement('button');
	  cancelBtn.textContent = '취소';
	  cancelBtn.addEventListener('click', () => overlay.remove());
	  buttons.append(confirmBtn, cancelBtn);
	  dialog.append(buttons);
	  overlay.append(dialog);
	  document.body.append(overlay);
	};

	const loadEvSlot = (slotIndex) => {
	  const slots = readSlots('expectedValue');
	  const s = slots[slotIndex];
	  if (!s?.pageState?.enhancementState) return;

	  const item = itemById.get(s.pageState.itemId);
	  if (!item) {
	    alert('저장된 아이템을 더 이상 찾을 수 없습니다.');
	    return;
	  }

	  // Set state in enhancement panel if setter exists
	  if (typeof window.__evSetState === 'function') {
	    window.__evSetState(s.pageState.enhancementState, item);
	  } else if (typeof window.activatePanel2 === 'function') {
	    // Fallback: re-activate panel with the saved item
	    window.activatePanel2(item);
	  }

	  renderEvSlotBar();
	  checkEvStarState();
	};

	// ---- State setter for loading saved slots ----
	window.__evSetState = (storedEnhancementState, storedItem) => {
	  // Restore the saved enhancement state (scrolls, gems, stimulant, level-ups)
	  if (typeof window.__restoreEvState === 'function') {
	    window.__restoreEvState(storedEnhancementState, storedItem);
	  } else if (typeof window.activatePanel2 === 'function') {
	    // Fallback: re-activate panel with a fresh state
	    window.activatePanel2(storedItem);
	  }
	  // After a brief delay, refresh the EV calc panel
	  setTimeout(() => {
	    if (typeof window.__evRefresh === 'function') {
	      window.__evRefresh();
	    }
	  }, 100);
	};

	// ---- Unsave confirmation (mirrors deconstruction page) ----
	const confirmUnsaveEvSlot = () => {
	  const state = buildEvPageState();
	  if (!state) return;
	  const slotIndex = findMatchingSlot('expectedValue', state);
	  if (slotIndex < 0) return;
	  const slots = readSlots('expectedValue');
	  const s = slots[slotIndex];
	  if (!s) return;

	  const overlay = document.createElement('div');
	  overlay.className = 'decon-confirm-overlay';
	  const dialog = document.createElement('div');
	  dialog.className = 'decon-confirm-dialog';

	  const msg = document.createElement('p');
	  msg.textContent = '이 설정은 슬롯에 저장되어 있습니다. 저장을 해제하시겠습니까?';
	  dialog.append(msg);

	  const card = document.createElement('div');
	  card.className = 'replace-confirm-card';
	  card.innerHTML = '<img src="' + buildItemIconUrl(s.item.iconId) + '" alt=""><div class="item-name">' + s.item.nameKo + '</div>';
	  dialog.append(card);

	  const buttons = document.createElement('div');
	  buttons.className = 'replace-confirm-buttons';
	  const confirmBtn = document.createElement('button');
	  confirmBtn.textContent = '해제';
	  confirmBtn.style.background = '#e74c3c';
	  confirmBtn.style.borderColor = '#e74c3c';
	  confirmBtn.style.color = '#fff';
	  confirmBtn.addEventListener('click', () => {
	    clearSlot('expectedValue', slotIndex);
	    overlay.remove();
	    renderEvSlotBar();
	    checkEvStarState();
	  });
	  const cancelBtn = document.createElement('button');
	  cancelBtn.textContent = '취소';
	  cancelBtn.addEventListener('click', () => overlay.remove());
	  buttons.append(confirmBtn, cancelBtn);
	  dialog.append(buttons);
	  overlay.append(dialog);
	  document.body.append(overlay);
	};

	// ---- Wire star button click ----
	if (evStar instanceof HTMLElement) {
	  evStar.addEventListener('click', () => {
	    if (evStar.classList.contains('item-card-star--saved')) {
	      confirmUnsaveEvSlot();
	    } else {
	      showEvSavePicker();
	    }
	  });
	}
</script>

<style>
