	setManualSearchOpen(false);
	syncJobButtons();
	syncItemSearchUrl();

	fetch('/data/items-gms83-ko.json')
		.then((response) => {
			if (!response.ok) {
				throw new Error(`Unable to load item index: ${response.status}`);
			}

			return response.json();
		})
		.then((items) => {
			itemIndex = Array.isArray(items) ? items : [];
			// Zero-stat items are cosmetic cash items — hide them from search.
			itemIndex = itemIndex.filter(
				(item) => Object.keys(item.stats ?? {}).length > 0,
