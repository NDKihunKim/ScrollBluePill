	const syncFiltersToSelectedItem = (item) => {
		syncJobsToSelectedItem(item);
		syncEquipmentToSelectedItem(item);

		if (levelMinInput instanceof HTMLInputElement && levelMaxInput instanceof HTMLInputElement) {
