		let currentGetCheckedStats = null;  // ref to active target UI getCheckedStats

	/** Update EV button enabled/disabled state based on current enhancement state. */
	const updateEvButtonState = () => {
		  const evState = window.__evState?.();
		  const calcStartBtn = document.querySelector('[data-ev-calc-start]');
		  if (!calcStartBtn || !(calcStartBtn instanceof HTMLButtonElement)) return;

	  if (!evState || !evState.enhancementState || !evState.selectedBaseItem) {
	    calcStartBtn.disabled = true;
	    return;
	  }

	  const st = evState.enhancementState;

	  // Only enable when at least one probability-based element exists
	  const hasNonDeterministicScroll = st.scrollState.slots.some(s => {
	    if (!s) return false;
	    if (s.behavior_type === 'chaos') return true;
	    const pctMatch = s.nameKo?.match(/(\d+)%/);
	    return pctMatch ? parseInt(pctMatch[1], 10) < 100 : false;
	  });
	  const hasProbabilityGem = st.gemSlots.some(s =>
	    s && s.stats && s.mode === 'probability'
	  );
	  const hasProbabilityStimulant = st.stimulantSlot?.mode === 'probability';
	  const hasLevelUp = st.itemLevelUpSlots.some(s => s !== null) && st.itemLevelUpMode === 'probability';

	  calcStartBtn.disabled = !(hasNonDeterministicScroll || hasProbabilityGem || hasProbabilityStimulant || hasLevelUp);
	};

	// Register callback for enhancement state changes
	window.__evRefresh = () => {
	  updateEvButtonState();
	  if (evResultSummary && evResultUI) {
	    evResultUI.showStale();
