{
  "name": "scrollbluepill",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:item-index": "node --env-file=.env scripts/generate-item-index.mjs",
    "generate:item-level-ups": "node --env-file=.env scripts/generate-item-level-up-index.mjs",
    "generate:scroll-index": "node --env-file=.env scripts/generate-scroll-index.mjs",
    "review:scrolls": "node --env-file=.env scripts/review-scroll-status.mjs",
    "seed:item-level-ups": "node --env-file=.env scripts/seed-item-level-up-definitions.mjs",
    "audit:duplicate-items": "node scripts/audit-duplicate-items.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "build": "npm run sync:data && astro build",
    "build:ci": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "seed:items": "node --env-file=.env scripts/seed-item-definitions.mjs",
    "review:items": "npm run generate:item-review && open outputs/item-review.html",
    "generate:item-review": "node --env-file=.env scripts/generate-item-review-page.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{astro,js,mjs,ts,css}'",
    "format:check": "prettier --check 'src/**/*.{astro,js,mjs,ts,css}'"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "pg": "^8.21.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  }
}
